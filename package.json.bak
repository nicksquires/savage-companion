  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:sources": "ts-node --project tsconfig.local.json prisma/seeds/sources.ts",
    "seed:core-tags": "ts-node --project tsconfig.local.json prisma/seeds/core/core-tags.ts",
    "seed:core-hindrances": "ts-node --project tsconfig.local.json prisma/seeds/core/core-hindrances.ts",
    "seed:core-edges": "ts-node --project tsconfig.local.json prisma/seeds/core/core-edges.ts",
    "seed:core-powers": "ts-node --project tsconfig.local.json prisma/seeds/core/core-powers.ts",
    "seed:core-racial-abilities": "ts-node --project tsconfig.local.json prisma/seeds/core/core-racial-abilities.ts",
    "seed:core-effects": "ts-node --project tsconfig.local.json prisma/seeds/core/core-effects",
    "seed:core-items": "ts-node --project tsconfig.local.json prisma/seeds/core/core-items.ts",
    "seed:core-firearms": "ts-node --project tsconfig.local.json prisma/seeds/core/items/core-firearms.ts",
    "seed:all": "ts-node --project tsconfig.local.json prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "daisyui": "^4.12.23",
    "fast-sort": "^3.4.1",
    "lucide-react": "^0.563.0",
    "next": "15.3.4",
    "next-auth": "^4.24.11",
    "next-cloudinary": "^6.16.0",
    "postcss": "^8.5.6",
    "prisma": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.local.json prisma/seed.ts"
  }
