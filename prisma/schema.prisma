  // potential state management on game session save/load
  SHAKEN
  DISTRACTED
  VULNERABLE
  ENTANGLED
  BOUND
  PRONE
  STUNNED
  FATIGUED
  EXHAUSTED
  INCAPACITATED

  // --- Environmental & Physical Conditions ---
  POISONED
  DRENCHED
  FROZEN
  BURNING
  HOT
  BLEEDING
  BLINDED
  DEAFENED
  SICKENED
  SUFFOCATING

  // --- Mental & Social Conditions ---
  FRIGHTENED
  ENRAGED
  CONFUSED
  CHARMED
  DOMINATED
  HOPELESS
  SHAMED

  // --- Supernatural & Arcane Conditions ---
  CURSED
  PETRIFIED
  WEAKENED
  HAUNTED
  ETHEREAL

  // --- Sci-Fi & Technological Conditions ---
  IRRADIATED
  HACKED
  MAGNETIZED
  SYSTEM_SHOCK
  JAMMED

  // --- Special / Custom ---
  CUSTOM // For homebrew conditions
}

