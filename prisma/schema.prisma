enum TargetType {
  SELF // Applies to the user/wielder
  ALLY // Applies to friendly targets
  ENEMY // Applies to hostile targets
  MULTI // Applies to multiple (e.g., allies or enemies in range)
  AREA // Applies to an area template (e.g., Small Burst)
  OBJECT // Applies to items/objects (rare, e.g., repair effects)
}

enum TriggerType {
  PASSIVE // Always active (e.g., +2 damage vs unholy)
  ON_HIT // Triggers on successful attack
  ON_EQUIP // Triggers when equipped/worn
  ON_USE // Triggers when activated (e.g., consumable)
  ON_ROLL // Triggers based on a roll outcome
  ON_CONDITION // Triggers when a condition is met (e.g., target is supernatural)
}

// May be replaced by EffectType
enum SpecialAbilityCategory {
  MOVEMENT
  OFFENSE
  DEFENSE
  IMMUNITIES
  RESISTANCE
  WEAKNESS
  SENSES
  TRAITS
  RECOVERY
  STATUSEFFECT
  COMBAT
  DURABILITY
  HAZARD
}

// Consider replacing XXX_ROLL types with 'TRIGGER' and the trigger can be a 'roll' or 'test'
enum EffectType {
  DAMAGE // Modifies damage roll (e.g., +2 for Blessed)
  TOUGHNESS // Modifies Toughness (e.g., +2 for Armor Bonus)
  PARRY // Modifies Parry score (e.g., -1 for Parry Penalty, +1 for Defensive)
  PACE // Modifies Pace (e.g., -1 for Encumbering)
  RESISTANCE_BYPASS // Ignores armor/resistances (e.g., Silvered, Cold Iron, Armor Piercing)
  ILLUMINATION_PENALTY // Modifies penalties due to lighting (e.g., negated by Glowing)
  SKILL_ROLL // Modifies skill rolls (e.g., +1 to Spellcasting for Spell Focus, -2 to Stealth for Noisy)
  POWER_POINTS // Modifies Power Point pool or usage (e.g., drained by Power Point Drain)
  ATTACK_ROLL // Modifies attack rolls (e.g., +2 for Three-Round Burst, -2 for Snapfire)
  AGILITY_ROLL // Modifies Agility-based rolls (e.g., -1 for Cumbersome)
  STEALTH_ROLL // Modifies Stealth rolls specifically (e.g., -2 for Noisy)
  CONCEALMENT_ROLL // Modifies rolls to hide items (e.g., +2 for Concealable)
  MULTI_ACTION_PENALTY // Modifies penalties for multi-actions (e.g., negated by Quick Draw)
  FATIGUE // Modifies Fatigue levels (e.g., +1 for Encumbering, Nonlethal, Cold-Based)
  STRENGTH_MINIMUM // Enforces minimum Strength die (e.g., d8 for Heavy Weapon)
  RATE_OF_FIRE // Modifies number of attack rolls per round (e.g., RoF 3 for Rate of Fire)
  RELOAD_TIME // Modifies actions needed to reload (e.g., +1 action for Reload)
  RANGE // Modifies weapon range (e.g., +1" for Reach)
  DAMAGE_ONGOING // Applies ongoing damage (e.g., fire for Fire-Based)
  MOVEMENT_PENALTY // Modifies movement penalties (e.g., -1 Pace for Entangling)
  SPELLCASTING_ROLL // Modifies Spellcasting rolls specifically (e.g., +1 for Spell Focus)
  BREAKAGE_CHANCE // Increases chance of item breaking (e.g., for Fragile)
  MALFUNCTION_CHANCE // Increases chance of malfunction (e.g., for Unstable)

  // Additional Savage Worlds mechanics
  WOUND_MODIFIER // Modifies Wound penalties (e.g., reduce penalty by 1)
  BENNY_COST // Modifies Benny usage cost (e.g., for rerolls or soak rolls)
  RUN_DIE // Modifies Run die roll (e.g., +1 to Running roll)
  SIZE_MODIFIER // Modifies Size for combat calculations (e.g., for large weapons)
  ARMOR_PENETRATION // Explicit AP value (complements RESISTANCE_BYPASS for specific AP points)
  HEALING_ROLL // Modifies Healing skill rolls
  INTIMIDATION_ROLL // Modifies Intimidation skill rolls
  TAUNT_ROLL // Modifies Taunt skill rolls
  NOTICE_ROLL // Modifies Notice skill rolls
  SURVIVAL_ROLL // Modifies Survival skill rolls
  TRACKING_ROLL // Modifies Tracking skill rolls
  INITIATIVE_CARD // Modifies Initiative card draws (e.g., +1 card or redraw)
}

enum FirearmType {
  PISTOL
  RIFLE
  SHOTGUN
  MACHINE_GUN
  LASER
  GATLING
  BLACK_POWDER
  IMPROVISED
  // Add more for settings 
}

enum FirearmMountType {
  NONE
  BIPOD
  TRIPOD
  VEHICLE
}

// The Account model in your schema is intended to support multiple 
// login providers per user. This doesn’t mean a user can log in as 
// multiple users, but rather that a single user can link multiple 
// authentication methods to their one account.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String                     @id @default(cuid())
  name             String?
  email            String                     @unique
  emailVerified    DateTime?                  @map("email_verified")
  hashedPassword   String?
  image            String?
  role             Role                       @default(FREE)
  accounts         Account[]
  sessions         Session[]
  registeredAt     DateTime                   @default(now())
  campaigns        Campaign[]
  campaignTemplate CampaignStartingTemplate[]
  campaignGMs      CampaignGM[] // Campaigns where user is GM (promoted) 
  PlayerCharacters PlayerCharacter[]
  subscriptions    Subscription[] // Link to subscriptions 

  // Homebrew Content (unchanged, but consolidated) 
  customEdges             Edge[]
  customPowers            Power[]
  customCreatures         Creature[]
  customSpecialAbilities  SpecialAbility[]
  customItems             Item[]
  customSkills            Skill[]
  customHindrances        Hindrance[]
  customRaces             Race[]
  customArcaneBackgrounds ArcaneBackground[]
  customEffects           Effect[]

  // Journals/Sessions 
  gmJournalEntries     GMJournalEntry[]
  playerJournalEntries PlayerJournalEntry[]
  campaignSession      CampaignSession[]

  @@index([email, role])
  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  tier      Role // BASIC, PREMIUM (sync with User.role) 
  startDate DateTime  @default(now())
  endDate   DateTime? // Null for lifetime or active 
  status    String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED 
  paymentId String? // Stripe ID or similar 

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

///////////////////////////////////////
//      GAME MECHANICS MODELS       //
/////////////////////////////////////

model Campaign {
  id                 String  @id @default(cuid())
  name               String
  description        String? @db.Text // Short description or blurb
  setting            String? // E.g., "Fantasy", "Sci-Fi"
  isActive           Boolean @default(true)
  startingTemplateId String?
  ownerId            String // Primary GM/creator 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User                      @relation(fields: [ownerId], references: [id])
  gms              CampaignGM[] // Multiple GMs 
  // players          CampaignPlayerCharacter[] // Join model
  creatures        CampaignCreature[] // Campaign wildcard NPCs
  sources          CampaignSource[] // Join model
  sessions         CampaignSession[] // NEW: linked play sessions
  edges            CampaignEdge[] // campaign-specific edge selection
  powers           CampaignPower[]
  items            CampaignItem[]
  hindrances       CampaignHindrance[]
  skills           CampaignSkill[]
  startingTemplate CampaignStartingTemplate? @relation(fields: [startingTemplateId], references: [id])
  assets           CampaignAsset[] // Arbitrary images 
  campaignNote     CampaignNote[]
  playerCharacters PlayerCharacter[]

  @@index([name, ownerId])
}

model CampaignGM {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  promotedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
}

model CampaignStartingTemplate {
  id          String  @id @default(cuid())
  name        String // e.g., "Psionics Heavy | The Last Parsec"
  description String?
  bonuses     Json? // Flexible: { "extraSkillPoints": 3, "autoSkills": [{ "skillId": "psionics-id", "dieType": "D4", "modifier": 0 }], "extraAttributePoints": 1, "autoEdges": ["arcane-resistance-id"], "extraWealth": 500 }

  isHomebrew Boolean  @default(false)
  ownerId    String? // GM who created it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  owner     User?      @relation(fields: [ownerId], references: [id])
  campaigns Campaign[] // Back-relation: templates can be reused

  @@index([name, ownerId])
}

model CampaignSession {
  id         String        @id @default(cuid())
  title      String
  summary    String? // Quick recap of the session
  date       DateTime      @default(now())
  duration   Int? // In minutes, optional, or format later to (days,hours,minutes)
  status     SessionStatus @default(PLANNED) // PLANNED, ACTIVE, ENDED 
  gmId       String? // GM for the session
  campaignId String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  gm       User?    @relation(fields: [gmId], references: [id])

  highlights      SessionEvent[] // Optional: individual events or milestones
  playerJournals  PlayerJournalEntry[]
  gmJournals      GMJournalEntry[]
  characterStates SessionCharacterState[] // New relation for state snapshots

  @@index([campaignId, date])
}

model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  timestamp   DateTime  @default(now())
  description String    @db.Text
  type        EventType @default(NARRATIVE) // e.g., Combat, RP, Travel

  session CampaignSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model SessionCharacterState {
  id         String     @id @default(cuid())
  sessionId  String
  entityId   String // References either CampaignPlayerCharacter.id or CampaignCreature.id
  entityType EntityType // PC or CREATURE
  bennies    Int        @default(3) // Wild Cards only; Extras typically 0
  wounds     Int        @default(0) // Max 3 for Wild Cards
  conditions Json?
  notes      String?    @db.Text // Additional GM notes
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])

  // CampaignPlayerCharacter   CampaignPlayerCharacter? @relation(fields: [campaignPlayerCharacterId], references: [id])
  // campaignPlayerCharacterId String?
  playerCharacter    PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id])
  playerCharacterId  String?
  campaignCreature   CampaignCreature? @relation(fields: [campaignCreatureId], references: [id])
  campaignCreatureId String?

  @@unique([sessionId, entityId, entityType])
  @@index([sessionId, entityId, entityType])
}

model PlayerJournalEntry {
  id          String  @id @default(cuid())
  sessionId   String
  userId      String
  characterId String? // Added for per-character journals 
  title       String
  body        String

  isPrivate Boolean  @default(true) // Players may choose to share or keep it private
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   CampaignSession  @relation(fields: [sessionId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  character PlayerCharacter? @relation(fields: [characterId], references: [id]) // Optional link 

  @@unique([sessionId, userId, characterId]) // Allow per-character/session uniqueness 
  @@index([userId, characterId])
}

model GMJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  gmId      String
  title     String
  body      String
  isPublic  Boolean  @default(false) // Added for public/private 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  gm      User            @relation(fields: [gmId], references: [id])

  @@index([sessionId, gmId])
}

model PlayerCharacter {
  id         String  @id @default(cuid())
  name       String
  concept    String? // Optional character concept or tagline
  userId     String // Owner of the character (user)
  raceId     String
  isActive   Boolean @default(true)
  imageUrl   String? // Added for optional images 
  campaignId String?

  // Advancement
  rank            Rank @default(NOVICE) // e.g., "NOVICE", "Seasoned"
  advancesSpent   Int  @default(0) // Taken/applied
  advancesUnspent Int  @default(0)
  experience      Int? @default(0) // Optional progress tracking between advances

  // Attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived/Combat Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)

  // Transient stats
  startingBennies Int @default(3)
  bennies         Int @default(3)
  wounds          Int @default(0)
  fatigue         Int @default(0)
  wealth          Int @default(500)

  description String? // Background, personality, etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  user              User                              @relation(fields: [userId], references: [id])
  race              Race                              @relation(fields: [raceId], references: [id])
  campaign          Campaign?                         @relation(fields: [campaignId], references: [id])
  edges             PlayerCharacterEdge[]
  powers            PlayerCharacterPower[]
  skills            PlayerCharacterSkill[]
  gear              PlayerCharacterItem[]
  hindrances        PlayerCharacterHindrance[]
  arcaneBackgrounds PlayerCharacterArcaneBackground[]
  modifiers         PlayerCharacterModifier[] // For temporary effects
  journals          PlayerJournalEntry[] // Back-relation for per-character notes 
  // campaigns         CampaignPlayerCharacter[]

  advancementLogs       AdvancementLog[] // Tracks advances
  SessionCharacterState SessionCharacterState[]

  @@index([userId, name, raceId])
}

// NEW: Optional log for auditability
model AdvancementLog {
  id                String          @id @default(cuid())
  playerCharacterId String
  spentAt           DateTime        @default(now())
  description       String // e.g., "Edge: Quick" or "Attribute: Agility d6"
  playerCharacter   PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
}

// Optional: For temporary stat adjustments
model PlayerCharacterModifier {
  id                String   @id @default(cuid())
  playerCharacterId String
  type              String // e.g., "WOUND", "FATIGUE", "BUFF"
  value             Int // e.g., -1 for wound penalty, +2 for buff
  description       String?
  duration          String? // e.g., "1 session", "until healed"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])

  @@index([playerCharacterId, type])
}

model Creature {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  raceId      String? // If creature has race
  imageUrl    String? // Added for images 
  notes       String?

  // Attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?   @relation(fields: [ownerId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])
  race   Race?   @relation(fields: [raceId], references: [id])

  campaigns         CampaignCreature[]
  abilities         CreatureAbility[]
  edges             CreatureEdge[]
  powers            CreaturePower[] // New, if creatures can have powers (merged from WildCardPower) 
  skills            CreatureSkill[]
  items             CreatureItem[]
  tags              CreatureTag[]
  creatureHindrance CreatureHindrance[]
  creatureCategory  CreatureCategory[]

  @@index([name, ownerId, sourceName])
}

model Race {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  ancestry    String? // Optional field for grouping (e.g., Elf, Human, etc.)
  imageUrl    String? // Added for images 

  sourceName String? // Reference to source book
  ownerId    String? // For homebrew authorship
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?           @relation(fields: [sourceName], references: [name])
  owner           User?             @relation(fields: [ownerId], references: [id])
  characters      PlayerCharacter[]
  creatures       Creature[] // For wildcard races
  racialAbilities RacialAbility[]

  @@index([name, sourceName, ownerId])
}

model RacialAbility {
  id                String  @id @default(cuid())
  value             Int // Point cost: positive (benefit) or negative (drawback)
  maxUses           Int? // Null if unlimited(U) or special condition
  customName        String? // Optional rename for flavor (e.g., "Blessed Miracles" for Arcane Background)
  customDescription String? @db.Text // Optional override or additional details
  slug              String  @unique

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String? // Reference to owner if homebrew
  sourceName String? // Reference to source book

  // Optional references (populate based on type enum)
  edgeId           String? // Edge value based on rank, max uses based on Natural Racial ability (U) 
  hindranceId      String? // Hindrance value based on severity, max uses 1
  skillId          String? // Skill value 1/2, max uses 1/skill
  attribute        String? // Value in SWADE pg.18-20, attribute increase maxUses (U) and attribute penalty maxUses once per attribute
  powerId          String? // Value in SWADE, grants Arcane Background edge + power
  specialAbilityId String? // Value set by GM, field for convenience as alternative to homebrew

  // Additional fields for granularity (optional, based on type)
  // bonusAmount Int? // e.g., +2 for attribute/skill die types, or starting die value
  // isMajor     Boolean? @default(false) // For hindrances: true = Major (-2), false = Minor (-1)... omitted for now since severity can be determined by hindranceId
  // extraConfig Json? // Arbitrary JSON for ability-specific configurations

  // Relations
  race           Race[]
  edge           Edge?           @relation(fields: [edgeId], references: [id])
  hindrance      Hindrance?      @relation(fields: [hindranceId], references: [id])
  skill          Skill?          @relation(fields: [skillId], references: [id])
  power          Power?          @relation(fields: [powerId], references: [id])
  specialAbility SpecialAbility? @relation(fields: [specialAbilityId], references: [id])
  source         Source?         @relation(fields: [sourceName], references: [name])
}

model Skill {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  linkedAttribute Attribute // "AGILITY", "SMARTS", etc.
  description     String?   @db.Text

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String? // Reference to owner if homebrew
  sourceName String? // Reference to source book

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User?                  @relation(fields: [ownerId], references: [id])
  source           Source?                @relation(fields: [sourceName], references: [name])
  characterSkills  PlayerCharacterSkill[]
  creatureSkills   CreatureSkill[]
  campaignSkills   CampaignSkill[]
  tags             SkillTag[]
  racialSkill      RacialAbility[]
  arcaneBackground ArcaneBackground[]

  @@index([name, sourceName, ownerId])
}

model Edge {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  category     String? // e.g., Background, Combat, Social
  rank         Rank    @default(NOVICE)
  requirements Json?
  effects      String  @db.Text
  summary      String? @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  owner          User?                 @relation(fields: [ownerId], references: [id])
  source         Source?               @relation(fields: [sourceName], references: [name])
  campaignEdges  CampaignEdge[]
  characterEdges PlayerCharacterEdge[]
  creatureEdges  CreatureEdge[]
  tags           EdgeTag[]
  racialEdge     RacialAbility[]

  @@index([name, rank, category, sourceName])
}

model ArcaneBackground {
  id             String  @id @default(cuid()) // Changed for consistency
  name           String  @unique // Ensure unique names for easy lookup
  arcaneSkillId  String
  startingPowers Int
  powerPoints    Int
  description    String  @db.Text
  summary        String? @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true) // Default true for core visibility
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now()) // Added for consistency
  updatedAt DateTime @updatedAt // Added for consistency

  // Relations
  arcaneSkill Skill   @relation(fields: [arcaneSkillId], references: [id])
  source      Source? @relation(fields: [sourceName], references: [name])
  owner       User?   @relation(fields: [ownerId], references: [id])

  playerCharacters PlayerCharacterArcaneBackground[] // Back-relation for many-to-many

  @@index([name, sourceName])
}

model Power {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  rank        Rank    @default(NOVICE) // enum: NOVICE, Seasoned, etc.
  powerPoints Int // Power cost
  // range       Int? // Usually derived from SMARTS
  duration    String?
  trappings   String? // Suggested trappings
  description String  @db.Text
  summary     String? @db.Text
  modifiers   String? // Possible modifiers (i.e., DAMAGE(+1) or SIZE (+1))

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?                @relation(fields: [sourceName], references: [name])
  owner           User?                  @relation(fields: [ownerId], references: [id])
  campaignPowers  CampaignPower[]
  characterPowers PlayerCharacterPower[]
  creaturePowers  CreaturePower[]
  racialPower     RacialAbility[]
  tags            PowerTag[]

  @@index([name, rank, sourceName])
}

model SpecialAbility {
  id          String  @id @default(cuid())
  name        String  @unique
  description String  @db.Text
  summary     String? @db.Text
  category    String // e.g., Movement, Defense, Offense, etc.
  parameters  Json? // e.g., { pace: "6", breathTemplate: "Cone", etc. }
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  // RELATIONS
  source            Source?             @relation(fields: [sourceName], references: [name])
  owner             User?               @relation(fields: [ownerId], references: [id])
  creatureAbilities CreatureAbility[]
  racialAbilities   RacialAbility[]
  tags              SpecialAbilityTag[]
}

model Hindrance {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  severity    HindranceType // Enum: MAJOR | MINOR
  description String        @db.Text
  summary     String?       @db.Text
  notes       String?       @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source Source? @relation(fields: [sourceName], references: [name])
  owner  User?   @relation(fields: [ownerId], references: [id])

  characterHindrances PlayerCharacterHindrance[]
  creatureHindrances  CreatureHindrance[]
  campaignHindrances  CampaignHindrance[]
  racialHindrance     RacialAbility[]

  @@index([name, severity, sourceName])
}

model Item {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  type        ItemType // e.g., weapon, armor, tool
  cost        Int?
  weight      Float? // e.g., '15', '(1/20)'
  imageUrl    String?

  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  source Source? @relation(fields: [sourceName], references: [name])
  owner  User?   @relation(fields: [ownerId], references: [id])

  // Relations to specialized models (1-to-1 optional)
  weapon      Weapon?
  armor       Armor?
  consumable  Consumable?
  tool        Tool?
  artifact    Artifact?
  magicDevice MagicDevice?

  // Relations to game entities
  characterItems PlayerCharacterItem[] // Join table relation for PC items
  creatureItems  CreatureItem[] // Join table relation for NPC items
  campaignItems  CampaignItem[] // Join table relation for campaign-specific items
  tags           ItemTag[]
  ItemEffect     ItemEffect[]
  itemInstances  ItemInstance[]

  @@index([name, type, sourceName])
}

model ItemInstance {
  id String @id @default(cuid())

  itemId     String
  campaignId String?

  // ownership (only one should be set)
  characterId String?
  creatureId  String?

  quantity Int     @default(1)
  notes    String?

  item           Item            @relation(fields: [itemId], references: [id])
  weaponInstance WeaponInstance?

  @@index([itemId, campaignId])
}

model Weapon {
  id     String @id @default(cuid())
  itemId String @unique

  damage      String? // e.g., "Str+d6" or "2d8"
  range       String? // e.g., "3/6/12" or "Melee"
  rof         Int? // Rate of Fire
  ap          Int? // Armor Piercing
  caliber     Float? // e.g., ".30" or "5.7"
  minStrength String? // e.g., "d6"

  firearm Firearm?
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WeaponInstance {
  id             String @id @default(cuid())
  itemInstanceId String @unique

  isBroken Boolean @default(false)
  isJammed Boolean @default(false)

  itemInstance    ItemInstance     @relation(fields: [itemInstanceId], references: [id])
  firearmInstance FirearmInstance?
}

model Firearm {
  id       String @id @default(cuid())
  weaponId String @unique

  firearmType   FirearmType? // e.g., SHOTGUN, LASER, SMG, BLACK POWDER
  ammoCapacity  Int? // e.g., 6 for revolver, 50 for machine gun belt
  reloadActions Int? // Number of actions to reload (e.g., 2 for Reload 2)

  mountType     FirearmMountType? // Affects Recoil, Strength requirements
  blastTemplate String? // e.g., "Small Burst" for HE rounds
  overchargeDie String? // e.g., "d6" for laser overcharge damage
  specialAmmo   String?           @db.Text // JSON or text for slugs, tracers, etc.

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@index([firearmType, mountType])
}

model FirearmInstance {
  id               String @id @default(cuid())
  weaponInstanceId String @unique

  currentAmmo   Int
  chamberLoaded Boolean @default(true)

  weaponInstance WeaponInstance @relation(fields: [weaponInstanceId], references: [id])
}

model Armor {
  id         String @id @default(cuid())
  itemId     String @unique
  armorBonus Int // e.g., +2 toughness

  covers       String? // e.g., "Torso, Arms, Legs" for querying coverage
  minStrength  String? // e.g., "d8"
  parryPenalty Int? // If applicable
  special      String? @db.Text // Free-text or relations for effects like "Noisy"

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Effect {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String @db.Text

  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?

  // New fields for programmatic handling
  targetType     TargetType? // e.g., ENEMY for Silvered, ENEMY, SELF, OBJECT, AREA, MULTI
  triggerType    TriggerType? // e.g., ON_HIT for Shock
  areaTemplate   String? // e.g., "Small Burst" for Glowing; use for AREA targets
  applicableData Json? // Fallback for ad-hoc data (e.g., { "customBonus": "+1 vs fire" })

  // Relations
  owner      User?             @relation(fields: [ownerId], references: [id])
  items      ItemEffect[]
  bonuses    EffectBonus[] // Modifiers (e.g., +2 damage)
  rolls      EffectRoll[] // Required rolls (e.g., Vigor roll for Shock)
  conditions EffectCondition[] // Outcomes (e.g., Shaken on failure)
  categories EffectCategory[] // Categories this effect applies to (e.g., UNHOLY for Blessed)

  // For active application in VTT (optional, see below)
  activeEffects ActiveEffect[]

  // @@index([slug, targetType, triggerType])
}

model EffectBonus {
  id         String      @id @default(cuid())
  effectId   String
  attribute  EffectType?
  value      Int
  isNegative Boolean     @default(false) // True for penalties (e.g., armor reducing Pace)

  // Optional condition (e.g., only vs certain categories; link to categories below)
  condition String? @db.Text // Free-text or JSON for complex logic (e.g., "vs UNHOLY")

  effect Effect @relation(fields: [effectId], references: [id], onDelete: Cascade)
}

model EffectRoll {
  id           String  @id @default(cuid())
  effectId     String
  skill        String // e.g., "VIGOR", "STRENGTH" (link to a Skill model if you have one)
  targetNumber Int? // Default 4 in SW, but overrideable
  onSuccess    String? @db.Text // Free-text outcome or link to another Effect/Condition
  onFailure    String? @db.Text // e.g., "Apply Shaken"

  effect Effect @relation(fields: [effectId], references: [id], onDelete: Cascade)
}

model EffectCondition {
  id       String        @id @default(cuid())
  effectId String
  type     ConditionType
  duration String? // e.g., "1 round", "Until recovery roll"
  onApply  String?       @db.Text // Additional effects (e.g., -2 to actions while Shaken)

  effect Effect @relation(fields: [effectId], references: [id], onDelete: Cascade)
  // For chaining: conditions can trigger other effects
  //childEffects Effect[]  // Recursive, but use sparingly to avoid cycles
}

model ItemEffect {
  itemId   String
  effectId String

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  effect Effect @relation(fields: [effectId], references: [id])

  @@id([itemId, effectId])
}

model ActiveEffect {
  id         String    @id @default(cuid())
  effectId   String
  targetId   String // Polymorphic: could be Creature.id, PlayerCharacter.id, etc.
  targetType String // e.g., "CREATURE", "PLAYER"
  startTime  DateTime? // Consider modifying to string or json for 'Round 3' or something
  endTime    DateTime? // For timed effects

  effect Effect @relation(fields: [effectId], references: [id], onDelete: Cascade)
  // Link to combat/session?
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "UNHOLY", "SUPERNATURAL"
  slug        String  @unique
  description String? @db.Text

  // Many-to-many with Effect (effects that apply to this category)
  effects EffectCategory[]

  // Many-to-many with Creature (creatures belonging to categories)
  creatures CreatureCategory[]
}

model EffectCategory {
  effectId   String
  categoryId String

  effect   Effect   @relation(fields: [effectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([effectId, categoryId])
}

model CreatureCategory {
  creatureId String
  categoryId String

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatureId, categoryId])
}

model Consumable {
  id          String  @id @default(cuid())
  itemId      String  @unique
  description String  @db.Text // Healing, buff, etc.
  maxUses     Int? // e.g., 3 charges
  isStackable Boolean @default(true)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tool {
  id     String @id @default(cuid())
  itemId String @unique

  // Type-specific fields, e.g.,
  skillBonus Int? // Bonus to a specific skill
  uses       Int? // Limited uses
  durability Int? // Durability test fail = -1 durability

  special String? @db.Text

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Artifact {
  id          String  @id @default(cuid())
  itemId      String  @unique
  rarity      String? // Common, Rare, Legendary
  description String  @db.Text // What it does mechanically
  charges     Int? // Uses, if applicable
  boundTo     String? // Optional: character ID if attuned

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// TO-DO: Examine Artificer specifics for model accuracy/necessity
model MagicDevice {
  id          String  @id @default(cuid())
  itemId      String  @unique
  powerPoints Int? // Starting PP pool
  recharge    String? // e.g., "1 PP/hour"
  special     String? @db.Text // Custom rules

  item   Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  spells MagicDeviceSpell[] // Relation to spells it can cast (see below)
}

// If devices can cast spells, add a many-to-many or one-to-many relation
model Spell {
  id             String @id @default(cuid())
  name           String
  description    String @db.Text
  rank           String // e.g., "Novice"
  powerPointCost Int
  // Other spell fields...

  magicDeviceSpells MagicDeviceSpell[]
}

model MagicDeviceSpell {
  magicDeviceId String
  spellId       String

  magicDevice MagicDevice @relation(fields: [magicDeviceId], references: [id], onDelete: Cascade)
  spell       Spell       @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@id([magicDeviceId, spellId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Join Tables
  edgeTags           EdgeTag[]
  powerTags          PowerTag[]
  creatureTags       CreatureTag[]
  specialAbilityTags SpecialAbilityTag[]
  skillTags          SkillTag[]
  itemTags           ItemTag[]

  @@index([name])
}

model CampaignNote {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model Source {
  id           String     @id @default(cuid())
  name         String     @unique // e.g., "Core Rules", "Fantasy Companion"
  type         SourceType @default(CORE) // Enum to distinguish source type
  abbreviation String? // e.g., "SWADE", "FC"
  description  String?    @db.Text
  publisher    String? // e.g., "Pinnacle Entertainment Group"
  url          String? // Optional link to official site or PDF
  isHomebrew   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  // RELATIONS

  abilities         SpecialAbility[]
  edges             Edge[]
  arcaneBackgrounds ArcaneBackground[]
  skills            Skill[]
  powers            Power[]
  creatures         Creature[]
  items             Item[]
  hindrances        Hindrance[]
  races             Race[]
  racialAbilities   RacialAbility[]

  campaigns CampaignSource[]

  @@index([name, type])
}

model CampaignAsset {
  id         String  @id @default(cuid())
  campaignId String
  name       String // e.g., "Town Map", "NPC Portrait" 
  imageUrl   String
  type       String? // e.g., "LOCATION", "NPC", "PROP" 
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, name])
}

