  edgeId String
  tagId  String

  edge Edge @relation(fields: [edgeId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@unique([edgeId, tagId])
}

model PowerTag {
  id      String @id @default(cuid())
  powerId String
  tagId   String

