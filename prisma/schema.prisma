generator client {
  provider = "prisma-client-js"
  //output   = "../app/generated/prisma"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  FREE
  BASIC
  PREMIUM
  ADMIN
}

enum Rank {
  NOVICE
  SEASONED
  VETERAN
  HEROIC
  LEGENDARY
}

enum Attribute {
  AGILITY
  SMARTS
  SPIRIT
  STRENGTH
  VIGOR
}

enum SourceType {
  CORE
  COMPANION
  HOMEBREW
  THIRD_PARTY
}

enum DieType {
  D4
  D6
  D8
  D10
  D12
  D20
  D30
  D50
  D100
}

enum HindranceType {
  MINOR
  MAJOR
}

enum EventType {
  NARRATIVE
  COMBAT
  EXPLORATION
  PUZZLE
  SOCIAL
  TRAVEL
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  AMMUNITION
  TOOL
  ARTIFACT
  KEY_ITEM
  COMPONENT
  MATERIAL
  MISC
}

enum SessionStatus {
  PLANNED
  ACTIVE
  PAUSED
  ENDED
}

enum EntityType {
  PC
  CREATURE
}

enum WeaponCategory {
  MELEE
  RANGED
  THROWN
  IMPROVISED

  FIREARM
  BLACK_POWDER
  ENERGY
  BOW
  CROSSBOW
  MAGIC
  PSIONIC

  HEAVY
  LIGHT
  TWO_HANDED
  ONE_HANDED
  REACH
  CONCEALED
  AREA
  SUPPRESSIVE

  PISTOL
  RIFLE
  SHOTGUN
  SMG
  CARBINE
  LAUNCHER
  MELEE_BLADE
  MELEE_BLUNT
  MELEE_PIERCE
  POLEARM
}

enum SettingType {
  MEDIEVAL
  MODERN
  WESTERN
  KIDS_ON_BIKES
  SLASHER
  HORROR
  FUTURISTIC
  ANCIENT_TIMES
  OTHERWORLD
  HISTORICAL_TIMES
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  MAP
}

enum ModifierEntityType {
  PLAYER
  CREATURE
  ITEM
  ENTITY
}

enum ModifierSourceType {
  POWER
  ITEM
  EDGE
  ABILITY
  NARRATIVE
  SYSTEM
}

enum DurationType {
  ROUNDS
  MINUTES
  HOURS
  ENCOUNTER
  PERMANENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role      @default(FREE)

  accounts Account[]
  sessions Session[]

  registeredAt DateTime @default(now())

  // Authored Homebrew
  authoredEdges             Edge[]
  authoredPowers            Power[]
  authoredCreatures         Creature[]
  authoredSpecialAbilities  SpecialAbility[]
  authoredItems             Item[]
  authoredSkills            Skill[]
  authoredHindrances        Hindrance[]
  authoredRaces             Race[]
  authoredArcaneBackgrounds ArcaneBackground[]

  // Subscribed Homebrew
  subscribedEdges             UserSubscribedEdge[]
  subscribedPowers            UserSubscribedPower[]
  subscribedCreatures         UserSubscribedCreature[]
  subscribedSpecialAbilities  UserSubscribedSpecialAbility[]
  subscribedItems             UserSubscribedItem[]
  subscribedSkills            UserSubscribedSkill[]
  subscribedHindrances        UserSubscribedHindrance[]
  subscribedRaces             UserSubscribedRace[]
  subscribedArcaneBackgrounds UserSubscribedArcaneBackground[]

  campaigns        Campaign[]
  campaignGMs      CampaignGM[]
  PlayerCharacters PlayerCharacter[]

  registeredSources UserRegisteredSource[]
  subscriptions     Subscription[]

  gmJournalEntries     GMJournalEntry[]
  playerJournalEntries PlayerJournalEntry[]
  campaignSessions     CampaignSession[]

  @@index([email, role])
  @@map("users")
}

model UserRegisteredSource {
  id         String @id @default(cuid())
  userId     String
  sourceName String // or sourceId if you prefer ID-based

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceName], references: [name])

  @@unique([userId, sourceName])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  tier      Role // BASIC, PREMIUM (sync with User.role) 
  startDate DateTime  @default(now())
  endDate   DateTime? // Null for lifetime or active 
  status    String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED 
  paymentId String? // Stripe ID or similar 

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// ====================== HOMEBREW SUBSCRIPTION JUNCTIONS ======================
model UserSubscribedEdge {
  id     String @id @default(cuid())
  userId String
  edgeId String

  user User @relation(fields: [userId], references: [id])
  edge Edge @relation(fields: [edgeId], references: [id])

  @@unique([userId, edgeId])
}

model UserSubscribedPower {
  id      String @id @default(cuid())
  userId  String
  powerId String

  user  User  @relation(fields: [userId], references: [id])
  power Power @relation(fields: [powerId], references: [id])

  @@unique([userId, powerId])
}

model UserSubscribedCreature {
  id         String @id @default(cuid())
  userId     String
  creatureId String

  user     User     @relation(fields: [userId], references: [id])
  creature Creature @relation(fields: [creatureId], references: [id])

  @@unique([userId, creatureId])
}

model UserSubscribedSpecialAbility {
  id               String @id @default(cuid())
  userId           String
  specialAbilityId String

  user           User           @relation(fields: [userId], references: [id])
  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])

  @@unique([userId, specialAbilityId])
}

model UserSubscribedItem {
  id     String @id @default(cuid())
  userId String
  itemId String

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model UserSubscribedSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model UserSubscribedHindrance {
  id          String @id @default(cuid())
  userId      String
  hindranceId String

  user      User      @relation(fields: [userId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([userId, hindranceId])
}

model UserSubscribedRace {
  id     String @id @default(cuid())
  userId String
  raceId String

  user User @relation(fields: [userId], references: [id])
  race Race @relation(fields: [raceId], references: [id])

  @@unique([userId, raceId])
}

model UserSubscribedArcaneBackground {
  id                 String @id @default(cuid())
  userId             String
  arcaneBackgroundId String

  user             User             @relation(fields: [userId], references: [id])
  arcaneBackground ArcaneBackground @relation(fields: [arcaneBackgroundId], references: [id])

  @@unique([userId, arcaneBackgroundId])
}

// ====================== HOMEBREW MODELS ======================
model Edge {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  imageUrl     String?
  iconUrl      String?
  rank         Rank    @default(NOVICE)
  category     String?
  description  String? @db.Text
  summary      String? @db.Text
  requirements Json?
  modifierData Json?

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])

  campaignEdges  CampaignEdge[]
  characterEdges PlayerCharacterEdge[]
  creatureEdges  CreatureEdge[]
  raceEdges      RaceEdge[]
  tags           EdgeTag[]

  subscribedBy UserSubscribedEdge[]
}

model Power {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  imageUrl     String?
  iconUrl      String?
  rank         Rank    @default(NOVICE)
  powerPoints  Int
  duration     String?
  trappings    String?
  description  String  @db.Text
  summary      String? @db.Text
  modifierData Json?

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  archivedAt DateTime?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])

  campaignPowers  CampaignPower[]
  characterPowers PlayerCharacterPower[]
  creaturePowers  CreaturePower[]
  tags            PowerTag[]
  subscribedBy    UserSubscribedPower[]
}

model Creature {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  raceId      String?
  imageUrl    String?
  iconUrl     String?
  notes       String?

  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  basePace      Int @default(6)
  baseParry     Int @default(0)
  baseToughness Int
  baseArmor     Int @default(0)

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(false)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])
  race   Race?   @relation(fields: [raceId], references: [id])

  abilities          CreatureAbility[]
  edges              CreatureEdge[]
  powers             CreaturePower[]
  skills             CreatureSkill[]
  tags               CreatureTag[]
  hindrances         CreatureHindrance[]
  instances          CreatureInstance[]
  subscribedBy       UserSubscribedCreature[]
  itemInstances      ItemInstance[]
  creatureCategories CreatureCategory[]

  @@index([name, authorId, sourceName])
}

model SpecialAbility {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  imageUrl     String?
  iconUrl      String?
  description  String  @db.Text
  summary      String?
  modifierData Json?

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(false)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])

  creatureAbilities CreatureAbility[]
  tags              SpecialAbilityTag[]
  subscribedBy      UserSubscribedSpecialAbility[]
}

model Item {
  id           String   @id @default(cuid())
  name         String   @unique
  // slug         String   @unique
  description  String?  @db.Text
  type         ItemType
  cost         Int?
  weight       Float?
  imageUrl     String?
  iconUrl      String?
  modifierData Json?

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])

  weapon       Weapon?
  armor        Armor?
  consumable   Consumable?
  tool         Tool?
  artifact     Artifact?
  tags         ItemTag[]
  instances    ItemInstance[]
  subscribedBy UserSubscribedItem[]
  ammunition   Ammunition?

  @@index([name, type, sourceName])
}

model Skill {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  imageUrl        String?
  iconUrl         String?
  linkedAttribute Attribute
  description     String?   @db.Text

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author           User?                  @relation(fields: [authorId], references: [id])
  source           Source?                @relation(fields: [sourceName], references: [name])
  characterSkills  PlayerCharacterSkill[]
  creatureSkills   CreatureSkill[]
  campaignSkills   CampaignSkill[]
  tags             SkillTag[]
  arcaneBackground ArcaneBackground[]

  subscribedBy UserSubscribedSkill[]
}

model Hindrance {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  imageUrl     String?
  iconUrl      String?
  severity     HindranceType
  description  String        @db.Text
  summary      String?       @db.Text
  notes        String?       @db.Text
  modifierData Json?

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author              User?                      @relation(fields: [authorId], references: [id])
  source              Source?                    @relation(fields: [sourceName], references: [name])
  characterHindrances PlayerCharacterHindrance[]
  creatureHindrances  CreatureHindrance[]
  campaignHindrances  CampaignHindrance[]
  subscribedBy        UserSubscribedHindrance[]

  raceHindrances RaceHindrance[]
}

model Race {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  ancestry    String?
  imageUrl    String?
  iconUrl     String?

  sourceName String?
  authorId   String?
  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author       User?                @relation(fields: [authorId], references: [id])
  source       Source?              @relation(fields: [sourceName], references: [name])
  characters   PlayerCharacter[]
  creatures    Creature[]
  subscribedBy UserSubscribedRace[]

  raceRacialAbilities RaceRacialAbility[]
  raceHindrances      RaceHindrance[]
  raceEdges           RaceEdge[]
  // raceArcaneBackground  RaceArcaneBackground[]
  // racePowers          RacePowers[]
}

model RaceRacialAbility {
  id              String @id @default(cuid())
  raceId          String
  racialAbilityId String

  race          Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  racialAbility RacialAbility @relation(fields: [racialAbilityId], references: [id], onDelete: Cascade)

  // Ensures a race can't accidentally be granted the exact same ability twice
  @@unique([raceId, racialAbilityId])
}

model RaceHindrance {
  id          String @id @default(cuid())
  raceId      String
  hindranceId String

  race      Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  hindrance Hindrance @relation(fields: [hindranceId], references: [id], onDelete: Cascade)

  @@unique([raceId, hindranceId])
}

model RaceEdge {
  id     String @id @default(cuid())
  raceId String
  edgeId String

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  edge Edge @relation(fields: [edgeId], references: [id], onDelete: Cascade)

  @@unique([raceId, edgeId])
}

model ArcaneBackground {
  id              String  @id @default(cuid())
  name            String  @unique
  slug            String  @unique
  imageUrl        String?
  iconUrl         String?
  arcaneSkillSlug String
  startingPowers  Int
  powerPoints     Int
  description     String  @db.Text
  summary         String? @db.Text

  isHomebrew Boolean   @default(false)
  isPublic   Boolean   @default(true)
  authorId   String?
  sourceName String?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arcaneSkill Skill   @relation(fields: [arcaneSkillSlug], references: [slug])
  source      Source? @relation(fields: [sourceName], references: [name])
  author      User?   @relation(fields: [authorId], references: [id])

  playerCharacters PlayerCharacterArcaneBackground[]
  subscribedBy     UserSubscribedArcaneBackground[]
}

// ====================== CHARACTER JUNCTIONS WITH SNAPSHOT ======================
model PlayerCharacterSource {
  id                String  @id @default(cuid())
  playerCharacterId String
  sourceName        String?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  source    Source?         @relation(fields: [sourceName], references: [name], onDelete: SetNull)

  @@unique([playerCharacterId, sourceName])
}

model PlayerCharacterEdge {
  id                String  @id @default(cuid())
  playerCharacterId String
  edgeId            String?
  mechanicsSnapshot Json?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  edge      Edge?           @relation(fields: [edgeId], references: [id], onDelete: SetNull)

  @@unique([playerCharacterId, edgeId])
}

model PlayerCharacterPower {
  id                String  @id @default(cuid())
  playerCharacterId String
  powerId           String?
  mechanicsSnapshot Json?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  power     Power?          @relation(fields: [powerId], references: [id], onDelete: SetNull)

  @@unique([playerCharacterId, powerId])
}

model PlayerCharacterSkill {
  id                String  @id @default(cuid())
  playerCharacterId String
  skillId           String?
  dieType           DieType @default(D4)
  mechanicsSnapshot Json?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  skill     Skill?          @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([playerCharacterId, skillId])
}

model PlayerCharacterHindrance {
  id                String  @id @default(cuid())
  playerCharacterId String
  hindranceId       String?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  hindrance Hindrance?      @relation(fields: [hindranceId], references: [id], onDelete: SetNull)

  @@unique([playerCharacterId, hindranceId])
}

model PlayerCharacterArcaneBackground {
  id                 String @id @default(cuid())
  playerCharacterId  String
  arcaneBackgroundId String

  character        PlayerCharacter  @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
  arcaneBackground ArcaneBackground @relation(fields: [arcaneBackgroundId], references: [id])

  @@unique([playerCharacterId, arcaneBackgroundId])
}

// ====================== CREATURE RELATIONS w/ MECHANICS SNAPSHOT ======================
model CreatureAbility {
  id                String @id @default(cuid())
  creatureId        String
  specialAbilityId  String
  mechanicsSnapshot Json?

  creature       Creature       @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])

  @@unique([creatureId, specialAbilityId])
}

model CreatureEdge {
  id                String @id @default(cuid())
  creatureId        String
  edgeId            String
  mechanicsSnapshot Json?

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([creatureId, edgeId])
}

model CreaturePower {
  id                String @id @default(cuid())
  creatureId        String
  powerId           String
  mechanicsSnapshot Json?

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([creatureId, powerId])
}

model CreatureSkill {
  id         String  @id @default(cuid())
  creatureId String
  skillId    String
  dieType    DieType @default(D4)
  modifier   Int     @default(0)

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([creatureId, skillId])
}

model CreatureHindrance {
  id                String @id @default(cuid())
  creatureId        String
  hindranceId       String
  mechanicsSnapshot Json?

  creature  Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([creatureId, hindranceId])
}

// ====================== CAMPAIGN MODELS ======================
model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  setting     String?
  isActive    Boolean @default(true)
  ownerId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User             @relation(fields: [ownerId], references: [id])
  gms     CampaignGM[]
  sources CampaignSource[]

  sessions           CampaignSession[]
  edges              CampaignEdge[]
  powers             CampaignPower[]
  hindrances         CampaignHindrance[]
  skills             CampaignSkill[]
  playerCharacters   PlayerCharacter[]
  characterInstances CharacterInstance[]
  creatureInstances  CreatureInstance[]
  media              CampaignMedia[]

  @@index([name, ownerId])
}

model CampaignGM {
  id         String @id @default(cuid())
  campaignId String
  userId     String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
}

model CampaignSource {
  id         String @id @default(cuid())
  campaignId String
  sourceName String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceName], references: [name])

  @@unique([campaignId, sourceName])
}

// ====================== SESSION MODELS ======================
model CampaignSession {
  id         String        @id @default(cuid())
  title      String
  summary    String?       @db.Text
  date       DateTime      @default(now())
  duration   Int?
  status     SessionStatus @default(PLANNED)
  gmId       String?
  campaignId String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  gm       User?    @relation(fields: [gmId], references: [id])

  events          SessionEvent[]
  playerJournals  PlayerJournalEntry[]
  gmJournals      GMJournalEntry[]
  characterStates SessionCharacterState[]

  @@index([campaignId, date])
}

model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  timestamp   DateTime  @default(now())
  description String    @db.Text
  type        EventType @default(NARRATIVE)

  session CampaignSession @relation(fields: [sessionId], references: [id])
}

model SessionCharacterState {
  id         String     @id @default(cuid())
  sessionId  String
  entityId   String
  entityType EntityType
  bennies    Int        @default(3)
  fatigue    Int        @default(0)
  wounds     Int        @default(0)
  conditions Json?
  notes      String?    @db.Text

  session           CampaignSession  @relation(fields: [sessionId], references: [id])
  playerCharacter   PlayerCharacter? @relation(fields: [playerCharacterId], references: [id])
  playerCharacterId String?
}

// ====================== PLAYER CHARACTER ======================
model PlayerCharacter {
  id         String  @id @default(cuid())
  userId     String
  name       String
  concept    String?
  biography  String?
  raceId     String
  isActive   Boolean @default(true)
  imageUrl   String?
  campaignId String?

  rank Rank @default(NOVICE)

  advancementsEnabled Boolean @default(false)
  advancesPerRank     Int     @default(4)

  advancesEarned  Int @default(0)
  advancesUnspent Int @default(0)

  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  pace      Int? @default(6)
  parry     Int? @default(0)
  toughness Int?
  armor     Int? @default(0)
  wealth    Int? @default(500)

  builderState Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                              @relation(fields: [userId], references: [id])
  race                   Race                              @relation(fields: [raceId], references: [id])
  campaign               Campaign?                         @relation(fields: [campaignId], references: [id])
  playerCharacterSources PlayerCharacterSource[]
  edges                  PlayerCharacterEdge[]
  powers                 PlayerCharacterPower[]
  skills                 PlayerCharacterSkill[]
  hindrances             PlayerCharacterHindrance[]
  arcaneBackgrounds      PlayerCharacterArcaneBackground[]
  inventory              ItemInstance[]
  journals               PlayerJournalEntry[]
  advancementLog         Advance[]
  characterInstance      CharacterInstance?
  sessionStates          SessionCharacterState[]

  @@index([userId, name, raceId])
}

model CharacterInstance {
  id          String @id @default(cuid())
  characterId String @unique
  campaignId  String

  wounds  Int @default(0)
  fatigue Int @default(0)
  bennies Int @default(3)

  paceOverride      Int?
  parryOverride     Int?
  toughnessOverride Int?
  armorOverride     Int?

  character PlayerCharacter @relation(fields: [characterId], references: [id])
  campaign  Campaign        @relation(fields: [campaignId], references: [id])

  items ItemInstance[]

  @@index([campaignId])
}

model Advance {
  id            String @id @default(cuid())
  characterId   String
  advanceNumber Int // Which advance was this? (e.g., 1, 2, 5)
  rankAtTime    Rank // What rank were they when they took this?

  type String // "EDGE", "ATTRIBUTE", "SKILL", "HINDRANCE"

  // JSON payload describing the specific change
  // e.g., { attribute: "VIGOR", from: "D6", to: "D8" } 
  // or { edgeSlug: "sweep" }
  payload Json?

  appliedAt DateTime? @default(now())

  character PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// ====================== MEDIA & JOURNAL ======================
model CampaignMedia {
  id         String    @id @default(cuid())
  campaignId String
  name       String
  url        String
  type       MediaType
  notes      String?

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model PlayerJournalEntry {
  id          String  @id @default(cuid())
  sessionId   String
  userId      String
  characterId String?
  title       String
  body        String

  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   CampaignSession  @relation(fields: [sessionId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  character PlayerCharacter? @relation(fields: [characterId], references: [id])

  @@index([userId, characterId])
}

model GMJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  gmId      String
  title     String
  body      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  gm      User            @relation(fields: [gmId], references: [id])
}

// ====================== SOURCE MODEL ======================
model Source {
  id           String     @id @default(cuid())
  name         String     @unique // e.g., "Core Rules", "Fantasy Companion"
  type         SourceType @default(CORE) // Enum to distinguish source type
  abbreviation String? // e.g., "SWADE", "FC"
  description  String?    @db.Text
  publisher    String? // e.g., "Pinnacle Entertainment Group"
  url          String? // Optional link to official site or PDF
  isHomebrew   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  // RELATIONS
  edges                  Edge[]
  skills                 Skill[]
  powers                 Power[]
  creatures              Creature[]
  items                  Item[]
  races                  Race[]
  hindrances             Hindrance[]
  specialAbilities       SpecialAbility[]
  arcaneBackgrounds      ArcaneBackground[]
  racialAbilities        RacialAbility[]
  playerCharacterSources PlayerCharacterSource[]
  campaigns              CampaignSource[]
  userRegisteredSources  UserRegisteredSource[]

  @@index([name, type])
}

// ====================== REMAINING CAMPAIGN JOIN TABLES ======================
model CampaignEdge {
  id         String @id @default(cuid())
  campaignId String
  edgeId     String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([campaignId, edgeId])
}

model CampaignPower {
  id         String @id @default(cuid())
  campaignId String
  powerId    String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([campaignId, powerId])
}

model CampaignSkill {
  id         String @id @default(cuid())
  campaignId String
  skillId    String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([campaignId, skillId])
}

model CampaignHindrance {
  id          String @id @default(cuid())
  campaignId  String
  hindranceId String

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([campaignId, hindranceId])
}

// ====================== CREATURE & ITEM SUPPORT ======================
model CreatureInstance {
  id String @id @default(cuid())

  creatureId String
  campaignId String

  nickname String?
  notes    String?

  // Campaign / runtime flags
  isWildCard Boolean @default(false)
  isNpc      Boolean @default(false)

  // Runtime state
  bennies Int @default(3)
  wounds  Int @default(0)
  fatigue Int @default(0)

  // Optional overrides (buffs, debuffs, damage)
  paceOverride      Int?
  parryOverride     Int?
  toughnessOverride Int?
  armorOverride     Int?

  creature Creature @relation(fields: [creatureId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  // Active play state
  items ItemInstance[]

  // creatureModifiers EntityModifier[]
  entityModifiers EntityModifier[]

  @@unique([campaignId, creatureId])
  @@index([campaignId])
}

// Core savage worlds mutation model
// For 'CREATURE' types modifiers: Look at promotion later, 
// "Save as New Creature" and flatten base+modifiers of 
// creature instance
model EntityModifier {
  id          String  @id @default(cuid())
  name        String
  description String?

  entityType ModifierEntityType
  entityId   String

  sourceType ModifierSourceType
  sourceId   String?

  durationType      DurationType
  durationRemaining Int?

  data      Json // validated by Zod (see below)
  condition Json? // complex "if" rules
  priority  Int   @default(0) // application order

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureInstance   CreatureInstance? @relation(fields: [creatureInstanceid], references: [id])
  creatureInstanceid String?
}

model RacialAbility {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String // e.g., "Low Light Vision", "Aquatic"
  description String? @db.Text
  value       Int // Point cost: +2, -1, etc.

  // THE BLUEPRINT: The definitive rules engine payload. 
  // Entity grants (Edges, Powers) will use unique slugs in the 'value' field.
  modifierData Json?

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  // Relations
  source Source? @relation(fields: [sourceName], references: [name])

  raceRacialAbilities RaceRacialAbility[]
}

model ItemInstance {
  id     String @id @default(cuid())
  itemId String

  characterId String?
  creatureId  String?
  containerId String?

  quantity   Int     @default(1)
  notes      String?
  isEquipped Boolean @default(false)
  state      Json?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  character           PlayerCharacter?   @relation(fields: [characterId], references: [id])
  creature            Creature?          @relation(fields: [creatureId], references: [id])
  characterInstance   CharacterInstance? @relation(fields: [characterInstanceId], references: [id])
  characterInstanceId String?
  creatureInstance    CreatureInstance?  @relation(fields: [creatureInstanceId], references: [id])
  creatureInstanceId  String?
}

model Weapon {
  id         String                     @id @default(cuid())
  itemId     String                     @unique
  categories WeaponCategoryAssignment[] // e.g., "MELEE", "RANGED"
  setting    SettingType? // e.g., MODERN, FUTURISTIC

  damage      String? // e.g., "Str+d6" or "2d8"
  range       String? // e.g., "3/6/12" or "Melee"
  rof         Int? // Rate of Fire
  ap          Int? // Armor Piercing
  caliber     Float? // e.g., ".30" or "5.7"
  minStrength String? // e.g., "d6"

  firearm Firearm?
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WeaponCategoryAssignment {
  weaponId String
  category WeaponCategory

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@id([weaponId, category])
}

model Firearm {
  id            String  @id @default(cuid())
  weaponId      String  @unique
  ammoCapacity  Int?
  reloadActions Int?
  mountType     String?
  blastTemplate String?
  overchargeDie String?
  specialAmmo   String? @db.Text

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)
}

model Armor {
  id           String  @id @default(cuid())
  itemId       String  @unique
  armorBonus   Int
  covers       String?
  minStrength  String?
  parryPenalty Int?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Ammunition {
  id        String  @id @default(cuid())
  itemId    String  @unique
  caliber   Int?
  ap        Int?
  damageMod String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Consumable {
  id          String  @id @default(cuid())
  itemId      String  @unique
  description String  @db.Text
  maxUses     Int?
  isStackable Boolean @default(true)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tool {
  id            String  @id @default(cuid())
  itemId        String  @unique
  skill         String?
  skillBonus    Int?
  maxUses       Int?
  maxDurability Int?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Artifact {
  id          String  @id @default(cuid())
  itemId      String  @unique
  rarity      String?
  description String  @db.Text
  maxCharges  Int?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "UNHOLY", "SUPERNATURAL"
  slug        String  @unique
  description String? @db.Text

  // Many-to-many with Creature (creatures belonging to categories)
  creatures CreatureCategory[]
}

model CreatureCategory {
  creatureId String
  categoryId String

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatureId, categoryId])
}

// ====================== TAG SYSTEM ======================
model Tag {
  id   String @id @default(cuid())
  name String @unique

  edgeTags           EdgeTag[]
  powerTags          PowerTag[]
  creatureTags       CreatureTag[]
  specialAbilityTags SpecialAbilityTag[]
  skillTags          SkillTag[]
  itemTags           ItemTag[]
}

model EdgeTag {
  id     String @id @default(cuid())
  edgeId String
  tagId  String

  edge Edge @relation(fields: [edgeId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@unique([edgeId, tagId])
}

model PowerTag {
  id      String @id @default(cuid())
  powerId String
  tagId   String

  power Power @relation(fields: [powerId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@unique([powerId, tagId])
}

model CreatureTag {
  id         String @id @default(cuid())
  creatureId String
  tagId      String

  creature Creature @relation(fields: [creatureId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@unique([creatureId, tagId])
}

model SpecialAbilityTag {
  id               String @id @default(cuid())
  specialAbilityId String
  tagId            String

  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])
  tag            Tag            @relation(fields: [tagId], references: [id])

  @@unique([specialAbilityId, tagId])
}

model SkillTag {
  id      String @id @default(cuid())
  skillId String
  tagId   String

  skill Skill @relation(fields: [skillId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@unique([skillId, tagId])
}

model ItemTag {
  id     String @id @default(cuid())
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@unique([itemId, tagId])
}

