// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../app/generated/prisma"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

///////////////////////
//      ENUMS       //
/////////////////////

enum Role {
  FREE
  BASIC
  PREMIUM
  ADMIN
}

enum Rank {
  NOVICE
  SEASONED
  VETERAN
  HEROIC
  LEGENDARY
}

enum Attribute {
  AGILITY
  SMARTS
  SPIRIT
  STRENGTH
  VIGOR
}

enum RequirementType {
  ATTRIBUTE
  SKILL
  EDGE
}

enum SpecialAbilityCategory {
  MOVEMENT
  OFFENSE
  DEFENSE
  IMMUNITIES
  RESISTANCE
  WEAKNESS
  SENSES
  TRAITS
  RECOVERY
  STATUSEFFECT
  COMBAT
  DURABILITY
  HAZARD
}

enum SourceType {
  CORE
  COMPANION
  HOMEBREW
  THIRD_PARTY
}

enum DieType {
  D4
  D6
  D8
  D10
  D12
  D20
  D30
  D50
  D100
}

enum HindranceType {
  MINOR
  MAJOR
}

enum EventType {
  NARRATIVE
  COMBAT
  EXPLORATION
  PUZZLE
  SOCIAL
  TRAVEL
}

enum ItemType {
  WEAPON
  ARMOR
  GEAR
  CONSUMABLE
  TOOL
  MISC
}

enum SessionStatus {
  PLANNED
  ACTIVE
  PAUSED
  ENDED
}

enum EntityType {
  PC
  CREATURE
}

enum ConditionType {
  // --- Core Savage Worlds Conditions ---
  // May be isolated to game logic, but enum exists for
  // potential state management on game session save/load
  SHAKEN
  DISTRACTED
  VULNERABLE
  ENTANGLED
  BOUND
  PRONE
  STUNNED
  FATIGUED
  EXHAUSTED
  INCAPACITATED

  // --- Environmental & Physical Conditions ---
  POISONED
  DRENCHED
  FROZEN
  BURNING
  HOT
  BLEEDING
  BLINDED
  DEAFENED
  SICKENED
  SUFFOCATING

  // --- Mental & Social Conditions ---
  FRIGHTENED
  ENRAGED
  CONFUSED
  CHARMED
  DOMINATED
  HOPELESS
  SHAMED

  // --- Supernatural & Arcane Conditions ---
  CURSED
  PETRIFIED
  WEAKENED
  HAUNTED
  ETHEREAL

  // --- Sci-Fi & Technological Conditions ---
  IRRADIATED
  HACKED
  MAGNETIZED
  SYSTEM_SHOCK
  JAMMED

  // --- Special / Custom ---
  CUSTOM // For homebrew conditions
}

