// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// The Account model in your schema is intended to support multiple 
// login providers per user. This doesn’t mean a user can log in as 
// multiple users, but rather that a single user can link multiple 
// authentication methods to their one account.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?         @map("email_verified")
  hashedPassword   String?
  image            String?
  accounts         Account[]
  sessions         Session[]
  registeredAt     DateTime          @default(now())
  campaigns        Campaign[]
  PlayerCharacters PlayerCharacter[]

  // Homebrew Content
  customEdges            Edge[]
  customPowers           Power[]
  customCreatures        Creature[]
  customSpecialAbilities SpecialAbility[]
  customItems            Item[]
  customSkills           Skill[]
  //customWildCards WildCard[]
  Hindrance              Hindrance[]
  CampaignSession        CampaignSession[]
  PlayerJournalEntry     PlayerJournalEntry[]
  GMJournalEntry         GMJournalEntry[]
  Race                   Race[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

///////////////////////////////////////
//      GAME MECHANICS MODELS       //
/////////////////////////////////////

model Campaign {
  id        String   @id @default(cuid())
  name      String
  summary   String? // Short description or blurb
  setting   String? // E.g., "Fantasy", "Sci-Fi"
  genre     String? // Optional: sword & sorcery, weird west, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership & Permissions
  ownerId String
  gm      User   @relation(fields: [ownerId], references: [id])

  // Campaign contents
  charTemplate        CharacterTemplate? // Optional for campaigns that use defaults
  players             CampaignPlayerCharacter[] // Join model
  npcs                CampaignWildCard[] // Optional: GM-created creatures for this campaign
  sources             CampaignSource[] // Join model
  sessions            CampaignSession[] // NEW: linked play sessions
  notes               CampaignNote[] // Optional: for shared or GM notes
  edges               CampaignEdge[] // campaign-specific edge selection
  powers              CampaignPower[]
  items               CampaignItem[]
  hindrances          CampaignHindrance[]
  creatures           CampaignCreature[]
  skills              CampaignSkill[]
  characterTemplateId String
}

model CampaignSession {
  id         String   @id @default(cuid())
  title      String
  summary    String? // Quick recap of the session
  date       DateTime @default(now())
  duration   Int? // In minutes, optional
  notes      String? // Session log or GM notes
  gmId       String? // GM for the session
  campaignId String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  gm       User?    @relation(fields: [gmId], references: [id])

  highlights    SessionEvent[] // Optional: individual events or milestones
  playerJournal PlayerJournalEntry[]
  gmJournal     GMJournalEntry[]
}

model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  timestamp   DateTime  @default(now())
  description String
  type        EventType @default(Narrative) // e.g., Combat, RP, Travel

  session CampaignSession @relation(fields: [sessionId], references: [id])
}

model PlayerJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  title     String
  content   String
  isPrivate Boolean  @default(true) // Players can choose to share or keep it private
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId]) // Prevent duplicate journal entries per player/session
}

model GMJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  gmId      String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  gm      User            @relation(fields: [gmId], references: [id])
}

model CharacterTemplate {
  id                  String @id @default(cuid())
  campaignId          String @unique
  startingWealth      Int    @default(500)
  startingSkillPoints Int    @default(12)
  startingEdges       Int    @default(1)
  startingHindrances  Int    @default(3)

  // Optional extra flexibility
  startingPace    Int @default(6)
  startingBennies Int @default(3)

  // Bonus skills, racial bonuses, etc.
  bonusSkills     CampaignSkill[]
  bonusEdges      CampaignEdge[]
  bonusHindrances CampaignHindrance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATION TO CAMPAIGN
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model PlayerCharacter {
  id               String  @id @default(cuid())
  name             String
  concept          String? // Optional character concept or tagline
  userId           String // Owner of the character (user)
  raceId           String
  arcaneBackground String? // Optional arcane background

  // Advancement
  rank       Rank // e.g., "Novice", "Seasoned"
  experience Int  @default(0)
  advances   Int  @default(0) // Number of advances taken

  // Attributes
  agility  DieType @default(d4)
  smarts   DieType @default(d4)
  spirit   DieType @default(d4)
  strength DieType @default(d4)
  vigor    DieType @default(d4)

  // Derived Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)
  bennies   Int @default(3)
  wounds    Int @default(0)
  fatigue   Int @default(0)

  // Inventory / Equipment / Powers / Edges
  wealth Int?    @default(500)
  gear   Json? // Optional JSON blob of carried items
  notes  String? // Background, personality, etc.

  // Modifiers for temporary in-game stat adjustments
  // woundModifier Int // Can be plus or minus to affect max health
  // skillModifier  Int // Plus or minus to affect skill rolls
  // 

  // Status + Meta
  // isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  user       User                       @relation(fields: [userId], references: [id])
  Race       Race                       @relation(fields: [raceId], references: [id])
  campaigns  CampaignPlayerCharacter[]
  edges      PlayerCharacterEdge[]
  powers     PlayerCharacterPower[]
  skills     PlayerCharacterSkill[]
  items      PlayerCharacterItem[]
  hindrances PlayerCharacterHindrance[]
}

model WildCard {
  id               String  @id @default(cuid())
  name             String
  concept          String? // Optional character concept or tagline
  raceId           String
  arcaneBackground String? // Optional arcane background

  // Advancement
  rank       Rank // e.g., "Novice", "Seasoned"
  experience Int  @default(0)
  advances   Int  @default(0) // Number of advances taken

  // Attributes
  agility  DieType @default(d4)
  smarts   DieType @default(d4)
  spirit   DieType @default(d4)
  strength DieType @default(d4)
  vigor    DieType @default(d4)

  // Derived Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)
  bennies   Int @default(3)
  wounds    Int @default(0)
  fatigue   Int @default(0)

  // Inventory / Equipment / Powers / Edges
  gear  Json? // Optional JSON blob of carried items
  notes String? // Background, personality, etc.

  // Modifiers for temporary in-game stat adjustments
  // woundModifier  Int  @default(0) // Can be plus or minus to affect max health
  // skillModifier  Int  @default(0) // Plus or minus to affect skill rolls

  // Homebrew / Visibility
  isHomebrew Boolean  @default(false)
  isPublic   Boolean  @default(false)
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // isActive  Boolean  @default(true)

  // RELATIONS
  wildCardCampaigns CampaignWildCard[]
  wildCardEdges     WildCardEdge[]
  wildCardPowers    WildCardPower[]
  wildCardSkills    WildCardSkill[]
  WildCardItem      WildCardItem[]
  WildCardHindrance WildCardHindrance[]
}

model Race {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  ancestry    String? // Optional field for grouping (e.g., Elf, Human, etc.)
  sourceId    String? // Reference to source book
  ownerId     String? // For homebrew authorship
  isHomebrew  Boolean @default(false)
  isPublic    Boolean @default(true)
  parentId    String? // For forking variants

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source         Source?              @relation(fields: [sourceId], references: [id])
  owner          User?                @relation(fields: [ownerId], references: [id])
  characters     PlayerCharacter[]
  raceEdges      RaceEdge[]
  racePowers     RacePower[]
  raceSkills     RaceSkill[]
  raceAbilities  RaceSpecialAbility[]
  raceHindrances RaceHindrance[]
}

model Skill {
  id              String  @id @default(cuid())
  name            String  @unique
  linkedAttribute String // "Agility", "Smarts", etc.
  description     String?

  // Homebrew / Visibility
  isHomebrew Boolean  @default(false)
  isPublic   Boolean  @default(false)
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id])

  // RELATIONS
  characterSkills PlayerCharacterSkill[]
  creatureSkills  CreatureSkill[]
  campaignSkills  CampaignSkill[]
  SkillTag        SkillTag[]
  WildCardSkill   WildCardSkill[]
  RaceSkill       RaceSkill[]
}

model Edge {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String? // e.g., Background, Combat, Social
  rank         Rank    @default(Novice)
  requirements Json? // Flexible requirements (e.g., { agility: "d8", rank: "Novice" })
  effects      String // Core effect or summary

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  parentId   String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  source         Source?               @relation(fields: [sourceId], references: [id])
  owner          User?                 @relation(fields: [ownerId], references: [id])
  campaignEdges  CampaignEdge[]
  characterEdges PlayerCharacterEdge[]
  creatureEdges  CreatureEdge[]
  edgeTags       EdgeTag[]
  WildCardEdge   WildCardEdge[]
  RaceEdge       RaceEdge[]
}

model Power {
  id          String  @id @default(cuid())
  name        String  @unique
  rank        Rank    @default(Novice) // enum: Novice, Seasoned, etc.
  powerPoints Int?
  duration    String
  effect      String
  trapping    String? // optional text description

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  parentId   String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?                @relation(fields: [sourceId], references: [id])
  owner           User?                  @relation(fields: [ownerId], references: [id])
  campaignPowers  CampaignPower[]
  characterPowers PlayerCharacterPower[]
  WildCardPower   WildCardPower[]
  powerTags       PowerTag[]
  RacePower       RacePower[]
}

model SpecialAbility {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  category    String // e.g., Movement, Defense, Offense, etc.
  parameters  Json? // e.g., { pace: "6", breathTemplate: "Cone", etc. }
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  parentId   String? // For variants or forks
  sourceId   String?

  // RELATIONS
  source Source? @relation(fields: [sourceId], references: [id])
  owner  User?   @relation(fields: [ownerId], references: [id])
  // mechanicalEffectId String?
  // mechanicalEffect   MechanicalEffect? @relation(fields: [mechanicalEffectId], references: [id])

  // Join Tables
  creatureAbilities  CreatureAbility[]
  specialAbilityTags SpecialAbilityTag[]
  RaceSpecialAbility RaceSpecialAbility[]
}

model Hindrance {
  id          String        @id @default(cuid())
  name        String        @unique
  severity    HindranceType // Enum: Major, Minor
  description String
  notes       String?

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  parentId   String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source Source? @relation(fields: [sourceId], references: [id])
  owner  User?   @relation(fields: [ownerId], references: [id])

  characterHindrances PlayerCharacterHindrance[]
  wildCardHindrances  WildCardHindrance[]
  CampaignHindrance   CampaignHindrance[]
  RaceHindrance       RaceHindrance[]
}

model Item {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  cost        Int?
  weight      Float? // e.g., '15', '(1/20)'
  type        ItemType // e.g., weapon, armor, tool - try to create 'enum itemType'

  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  parentId   String?
  sourceId   String?

  source        Source?               @relation(fields: [sourceId], references: [id])
  owner         User?                 @relation(fields: [ownerId], references: [id])
  CharacterItem PlayerCharacterItem[]
  WildCardItem  WildCardItem[]
  CreatureItem  CreatureItem[]
  ItemTag       ItemTag[]
  CampaignItem  CampaignItem[]
}

model Creature {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Attributes
  agility  DieType @default(d4)
  smarts   DieType @default(d4)
  spirit   DieType @default(d4)
  strength DieType @default(d4)
  vigor    DieType @default(d4)

  // Derived Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int

  // Bonus/variable stats
  armor   Int @default(0)
  wounds  Int @default(0)
  fatigue Int @default(0)

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  parentId   String?
  sourceId   String?

  source Source? @relation(fields: [sourceId], references: [id])
  owner  User?   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  campaigns CampaignCreature[]
  abilities CreatureAbility[]
  skills    CreatureSkill[]
  edges     CreatureEdge[]
  tags      CreatureTag[]
  items     CreatureItem[]
}

model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Join Tables
  edgeTags          EdgeTag[]
  powerTags         PowerTag[]
  creatureTags      CreatureTag[]
  specialAbilityTag SpecialAbilityTag[]
  skillTag          SkillTag[]
  ItemTag           ItemTag[]
}

model CampaignNote {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model Source {
  id           String     @id @default(cuid())
  name         String     @unique // e.g., "Core Rules", "Fantasy Companion"
  type         SourceType @default(CORE) // Enum to distinguish source type
  abbreviation String? // e.g., "SWADE", "FC"
  description  String? // Optional longer description
  publisher    String? // e.g., "Pinnacle Entertainment Group"
  url          String? // Optional link to official site or PDF
  isHomebrew   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // RELATIONS

  abilities  SpecialAbility[]
  edges      Edge[]
  powers     Power[]
  creatures  Creature[]
  items      Item[]
  hindrances Hindrance[]

  campaigns CampaignSource[]
  Race      Race[]
}

