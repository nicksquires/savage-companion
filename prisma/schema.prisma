// The Account model in your schema is intended to support multiple 
// login providers per user. This doesn’t mean a user can log in as 
// multiple users, but rather that a single user can link multiple 
// authentication methods to their one account.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String                     @id @default(cuid())
  name             String?
  email            String                     @unique
  emailVerified    DateTime?                  @map("email_verified")
  hashedPassword   String?
  image            String?
  role             Role                       @default(FREE)
  accounts         Account[]
  sessions         Session[]
  registeredAt     DateTime                   @default(now())
  campaigns        Campaign[]
  campaignTemplate CampaignStartingTemplate[]
  campaignGMs      CampaignGM[] // Campaigns where user is GM (promoted) 
  PlayerCharacters PlayerCharacter[]
  subscriptions    Subscription[] // Link to subscriptions 

  // Homebrew Content (unchanged, but consolidated) 
  customEdges             Edge[]
  customPowers            Power[]
  customCreatures         Creature[]
  customSpecialAbilities  SpecialAbility[]
  customItems             Item[]
  customSkills            Skill[]
  customHindrances        Hindrance[]
  customRaces             Race[]
  customArcaneBackgrounds ArcaneBackground[]

  // Journals/Sessions 
  gmJournalEntries     GMJournalEntry[]
  playerJournalEntries PlayerJournalEntry[]
  campaignSession      CampaignSession[]

  @@index([email, role])
  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  tier      Role // BASIC, PREMIUM (sync with User.role) 
  startDate DateTime  @default(now())
  endDate   DateTime? // Null for lifetime or active 
  status    String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED 
  paymentId String? // Stripe ID or similar 

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

///////////////////////////////////////
//      GAME MECHANICS MODELS       //
/////////////////////////////////////

model Campaign {
  id                 String  @id @default(cuid())
  name               String
  description        String? @db.Text // Short description or blurb
  setting            String? // E.g., "Fantasy", "Sci-Fi"
  isActive           Boolean @default(true)
  startingTemplateId String?
  ownerId            String // Primary GM/creator 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User                      @relation(fields: [ownerId], references: [id])
  gms              CampaignGM[] // Multiple GMs 
  // players          CampaignPlayerCharacter[] // Join model
  creatures        CampaignCreature[] // Campaign wildcard NPCs
  sources          CampaignSource[] // Join model
  sessions         CampaignSession[] // NEW: linked play sessions
  edges            CampaignEdge[] // campaign-specific edge selection
  powers           CampaignPower[]
  items            CampaignItem[]
  hindrances       CampaignHindrance[]
  skills           CampaignSkill[]
  startingTemplate CampaignStartingTemplate? @relation(fields: [startingTemplateId], references: [id])
  assets           CampaignAsset[] // Arbitrary images 
  campaignNote     CampaignNote[]
  playerCharacters PlayerCharacter[]

  @@index([name, ownerId])
}

model CampaignGM {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  promotedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
}

model CampaignStartingTemplate {
  id          String  @id @default(cuid())
  name        String // e.g., "Psionics Heavy | The Last Parsec"
  description String?
  bonuses     Json? // Flexible: { "extraSkillPoints": 3, "autoSkills": [{ "skillId": "psionics-id", "dieType": "D4", "modifier": 0 }], "extraAttributePoints": 1, "autoEdges": ["arcane-resistance-id"], "extraWealth": 500 }

  isHomebrew Boolean  @default(false)
  ownerId    String? // GM who created it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  owner     User?      @relation(fields: [ownerId], references: [id])
  campaigns Campaign[] // Back-relation: templates can be reused

  @@index([name, ownerId])
}

model CampaignSession {
  id         String        @id @default(cuid())
  title      String
  summary    String? // Quick recap of the session
  date       DateTime      @default(now())
  duration   Int? // In minutes, optional, or format later to (days,hours,minutes)
  status     SessionStatus @default(PLANNED) // PLANNED, ACTIVE, ENDED 
  gmId       String? // GM for the session
  campaignId String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  gm       User?    @relation(fields: [gmId], references: [id])

  highlights      SessionEvent[] // Optional: individual events or milestones
  playerJournals  PlayerJournalEntry[]
  gmJournals      GMJournalEntry[]
  characterStates SessionCharacterState[] // New relation for state snapshots

  @@index([campaignId, date])
}

model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  timestamp   DateTime  @default(now())
  description String    @db.Text
  type        EventType @default(NARRATIVE) // e.g., Combat, RP, Travel

  session CampaignSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

//   Expected json format for 'conditions'
// [
//   { "type": "SHAKEN", 
//   "notes": "Failed Spirit roll", 
//   "duration": "Until recovery" 
//   }, 
//   { "type": "CUSTOM", 
//   "name": "Cursed", 
//   "notes": "From ritual", 
//   "duration": "1 session" }
// ]
model SessionCharacterState {
  id         String     @id @default(cuid())
  sessionId  String
  entityId   String // References either CampaignPlayerCharacter.id or CampaignCreature.id
  entityType EntityType // PC or CREATURE
  bennies    Int        @default(3) // Wild Cards only; Extras typically 0
  wounds     Int        @default(0) // Max 3 for Wild Cards
  conditions Json?
  notes      String?    @db.Text // Additional GM notes
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])

  // CampaignPlayerCharacter   CampaignPlayerCharacter? @relation(fields: [campaignPlayerCharacterId], references: [id])
  // campaignPlayerCharacterId String?
  playerCharacter    PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id])
  playerCharacterId  String?
  campaignCreature   CampaignCreature? @relation(fields: [campaignCreatureId], references: [id])
  campaignCreatureId String?

  @@unique([sessionId, entityId, entityType])
  @@index([sessionId, entityId, entityType])
}

model PlayerJournalEntry {
  id          String  @id @default(cuid())
  sessionId   String
  userId      String
  characterId String? // Added for per-character journals 
  title       String
  body        String

  isPrivate Boolean  @default(true) // Players may choose to share or keep it private
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   CampaignSession  @relation(fields: [sessionId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  character PlayerCharacter? @relation(fields: [characterId], references: [id]) // Optional link 

  @@unique([sessionId, userId, characterId]) // Allow per-character/session uniqueness 
  @@index([userId, characterId])
}

model GMJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  gmId      String
  title     String
  body      String
  isPublic  Boolean  @default(false) // Added for public/private 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  gm      User            @relation(fields: [gmId], references: [id])

  @@index([sessionId, gmId])
}

model PlayerCharacter {
  id         String  @id @default(cuid())
  name       String
  concept    String? // Optional character concept or tagline
  userId     String // Owner of the character (user)
  raceId     String
  isActive   Boolean @default(true)
  imageUrl   String? // Added for optional images 
  campaignId String?

  // Advancement
  rank            Rank @default(NOVICE) // e.g., "NOVICE", "Seasoned"
  advancesSpent   Int  @default(0) // Taken/applied
  advancesUnspent Int  @default(0)
  experience      Int? @default(0) // Optional progress tracking between advances

  // Attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived/Combat Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)

  // Transient stats
  startingBennies Int @default(3)
  bennies         Int @default(3)
  wounds          Int @default(0)
  fatigue         Int @default(0)
  wealth          Int @default(500)

  description String? // Background, personality, etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  user              User                              @relation(fields: [userId], references: [id])
  race              Race                              @relation(fields: [raceId], references: [id])
  campaign          Campaign?                         @relation(fields: [campaignId], references: [id])
  edges             PlayerCharacterEdge[]
  powers            PlayerCharacterPower[]
  skills            PlayerCharacterSkill[]
  gear              PlayerCharacterItem[]
  hindrances        PlayerCharacterHindrance[]
  arcaneBackgrounds PlayerCharacterArcaneBackground[]
  modifiers         PlayerCharacterModifier[] // For temporary effects
  journals          PlayerJournalEntry[] // Back-relation for per-character notes 
  // campaigns         CampaignPlayerCharacter[]

  advancementLogs       AdvancementLog[] // Tracks advances
  SessionCharacterState SessionCharacterState[]

  @@index([userId, name, raceId])
}

// NEW: Optional log for auditability
model AdvancementLog {
  id                String          @id @default(cuid())
  playerCharacterId String
  spentAt           DateTime        @default(now())
  description       String // e.g., "Edge: Quick" or "Attribute: Agility d6"
  playerCharacter   PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
}

// Optional: For temporary stat adjustments
model PlayerCharacterModifier {
  id                String   @id @default(cuid())
  playerCharacterId String
  type              String // e.g., "WOUND", "FATIGUE", "BUFF"
  value             Int // e.g., -1 for wound penalty, +2 for buff
  description       String?
  duration          String? // e.g., "1 session", "until healed"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])

  @@index([playerCharacterId, type])
}

model Creature {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  raceId      String? // If creature has race
  imageUrl    String? // Added for images 
  notes       String?

  // Attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?   @relation(fields: [ownerId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])
  race   Race?   @relation(fields: [raceId], references: [id])

  campaigns         CampaignCreature[]
  abilities         CreatureAbility[]
  edges             CreatureEdge[]
  powers            CreaturePower[] // New, if creatures can have powers (merged from WildCardPower) 
  skills            CreatureSkill[]
  items             CreatureItem[]
  tags              CreatureTag[]
  CreatureHindrance CreatureHindrance[]

  @@index([name, ownerId, sourceName])
}

model Race {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  ancestry    String? // Optional field for grouping (e.g., Elf, Human, etc.)

  sourceName String? // Reference to source book
  ownerId    String? // For homebrew authorship
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?           @relation(fields: [sourceName], references: [name])
  owner           User?             @relation(fields: [ownerId], references: [id])
  characters      PlayerCharacter[]
  creatures       Creature[] // For wildcard races
  racialAbilities RacialAbility[]

  @@index([name, sourceName, ownerId])
}

model RacialAbility {
  id                String  @id @default(cuid())
  value             Int // Point cost: positive (benefit) or negative (drawback)
  maxUses           Int? // Null if unlimited(U) or special condition
  customName        String? // Optional rename for flavor (e.g., "Blessed Miracles" for Arcane Background)
  customDescription String? @db.Text // Optional override or additional details
  slug              String  @unique

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String? // Reference to owner if homebrew
  sourceName String? // Reference to source book

  // Optional references (populate based on type enum)
  edgeId           String? // Edge value based on rank, max uses based on Natural Racial ability (U) 
  hindranceId      String? // Hindrance value based on severity, max uses 1
  skillId          String? // Skill value 1/2, max uses 1/skill
  attribute        String? // Value in SWADE pg.18-20, attribute increase maxUses (U) and attribute penalty maxUses once per attribute
  powerId          String? // Value in SWADE, grants Arcane Background edge + power
  specialAbilityId String? // Value set by GM, field for convenience as alternative to homebrew

  // Additional fields for granularity (optional, based on type)
  // bonusAmount Int? // e.g., +2 for attribute/skill die types, or starting die value
  // isMajor     Boolean? @default(false) // For hindrances: true = Major (-2), false = Minor (-1)... omitted for now since severity can be determined by hindranceId
  // extraConfig Json? // Arbitrary JSON for ability-specific configurations

  // Relations
  race           Race[]
  edge           Edge?           @relation(fields: [edgeId], references: [id])
  hindrance      Hindrance?      @relation(fields: [hindranceId], references: [id])
  skill          Skill?          @relation(fields: [skillId], references: [id])
  power          Power?          @relation(fields: [powerId], references: [id])
  specialAbility SpecialAbility? @relation(fields: [specialAbilityId], references: [id])
  source         Source?         @relation(fields: [sourceName], references: [name])
}

model Skill {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  linkedAttribute Attribute // "AGILITY", "SMARTS", etc.
  description     String?   @db.Text

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String? // Reference to owner if homebrew
  sourceName String? // Reference to source book

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User?                  @relation(fields: [ownerId], references: [id])
  source           Source?                @relation(fields: [sourceName], references: [name])
  characterSkills  PlayerCharacterSkill[]
  creatureSkills   CreatureSkill[]
  campaignSkills   CampaignSkill[]
  tags             SkillTag[]
  racialSkill      RacialAbility[]
  arcaneBackground ArcaneBackground[]

  @@index([name, sourceName, ownerId])
}

model Edge {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  category     String? // e.g., Background, Combat, Social
  rank         Rank    @default(NOVICE)
  requirements Json?
  effects      String  @db.Text
  summary      String? @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  owner          User?                 @relation(fields: [ownerId], references: [id])
  source         Source?               @relation(fields: [sourceName], references: [name])
  campaignEdges  CampaignEdge[]
  characterEdges PlayerCharacterEdge[]
  creatureEdges  CreatureEdge[]
  tags           EdgeTag[]
  racialEdge     RacialAbility[]

  @@index([name, rank, category, sourceName])
}

model ArcaneBackground {
  id             String  @id @default(cuid()) // Changed for consistency
  name           String  @unique // Ensure unique names for easy lookup
  arcaneSkillId  String
  startingPowers Int
  powerPoints    Int
  description    String  @db.Text
  summary        String? @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true) // Default true for core visibility
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now()) // Added for consistency
  updatedAt DateTime @updatedAt // Added for consistency

  // Relations
  arcaneSkill Skill   @relation(fields: [arcaneSkillId], references: [id])
  source      Source? @relation(fields: [sourceName], references: [name])
  owner       User?   @relation(fields: [ownerId], references: [id])

  playerCharacters PlayerCharacterArcaneBackground[] // Back-relation for many-to-many

  @@index([name, sourceName])
}

model Power {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  rank        Rank    @default(NOVICE) // enum: NOVICE, Seasoned, etc.
  powerPoints Int // Power cost
  // range       Int? // Usually derived from SMARTS
  duration    String?
  trappings   String? // Suggested trappings
  description String  @db.Text
  summary     String? @db.Text
  modifiers   String? // Possible modifiers (i.e., DAMAGE(+1) or SIZE (+1))

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?                @relation(fields: [sourceName], references: [name])
  owner           User?                  @relation(fields: [ownerId], references: [id])
  campaignPowers  CampaignPower[]
  characterPowers PlayerCharacterPower[]
  creaturePowers  CreaturePower[]
  racialPower     RacialAbility[]
  tags            PowerTag[]

  @@index([name, rank, sourceName])
}

model SpecialAbility {
  id          String  @id @default(cuid())
  name        String  @unique
  description String  @db.Text
  summary     String? @db.Text
  category    String // e.g., Movement, Defense, Offense, etc.
  parameters  Json? // e.g., { pace: "6", breathTemplate: "Cone", etc. }
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  // RELATIONS
  source            Source?             @relation(fields: [sourceName], references: [name])
  owner             User?               @relation(fields: [ownerId], references: [id])
  creatureAbilities CreatureAbility[]
  racialAbilities   RacialAbility[]
  tags              SpecialAbilityTag[]
}

model Hindrance {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  severity    HindranceType // Enum: MAJOR | MINOR
  description String        @db.Text
  summary     String?       @db.Text
  notes       String?       @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source Source? @relation(fields: [sourceName], references: [name])
  owner  User?   @relation(fields: [ownerId], references: [id])

  characterHindrances PlayerCharacterHindrance[]
  creatureHindrances  CreatureHindrance[]
  campaignHindrances  CampaignHindrance[]
  racialHindrance     RacialAbility[]

  @@index([name, severity, sourceName])
}

model Item {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @db.Text
  type        ItemType // e.g., weapon, armor, tool
  cost        Int?
  weight      Float? // e.g., '15', '(1/20)'
  imageUrl    String?

  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  source         Source?               @relation(fields: [sourceName], references: [name])
  owner          User?                 @relation(fields: [ownerId], references: [id])
  characterItems PlayerCharacterItem[]
  creatureItems  CreatureItem[]
  campaignItems  CampaignItem[]
  tags           ItemTag[]

  @@index([name, type, sourceName])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Join Tables
  edgeTags           EdgeTag[]
  powerTags          PowerTag[]
  creatureTags       CreatureTag[]
  specialAbilityTags SpecialAbilityTag[]
  skillTags          SkillTag[]
  itemTags           ItemTag[]

  @@index([name])
}

model CampaignNote {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model Source {
  id           String     @id @default(cuid())
  name         String     @unique // e.g., "Core Rules", "Fantasy Companion"
  type         SourceType @default(CORE) // Enum to distinguish source type
  abbreviation String? // e.g., "SWADE", "FC"
  description  String?    @db.Text
  publisher    String? // e.g., "Pinnacle Entertainment Group"
  url          String? // Optional link to official site or PDF
  isHomebrew   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  // RELATIONS

  abilities         SpecialAbility[]
  edges             Edge[]
  arcaneBackgrounds ArcaneBackground[]
  skills            Skill[]
  powers            Power[]
  creatures         Creature[]
  items             Item[]
  hindrances        Hindrance[]
  races             Race[]
  racialAbilities   RacialAbility[]

  campaigns CampaignSource[]

  @@index([name, type])
}

model CampaignAsset {
  id         String  @id @default(cuid())
  campaignId String
  name       String // e.g., "Town Map", "NPC Portrait" 
  imageUrl   String
  type       String? // e.g., "LOCATION", "NPC", "PROP" 
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, name])
}

