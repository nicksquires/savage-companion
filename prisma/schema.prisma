model CampaignCreature {
  id         String  @id @default(cuid())
  campaignId String
  creatureId String
  nickname   String?
  notes      String?

  // Campaign stats
  isWildCard Boolean @default(false) // Merged from WildCard
  isNpc      Boolean @default(false)
  bennies    Int     @default(3)
  wounds     Int     @default(0)
  fatigue    Int     @default(0)

  campaign      Campaign                @relation(fields: [campaignId], references: [id])
  creature      Creature                @relation(fields: [creatureId], references: [id])
  sessionStates SessionCharacterState[] // Back-relation for creature states

  @@unique([campaignId, creatureId])
  @@index([campaignId, creatureId])
}

model CampaignEdge {
  id         String  @id @default(cuid())
  campaignId String
  edgeId     String
  isEnabled  Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([campaignId, edgeId])
  @@index([campaignId])
}

model CampaignPower {
  id                String  @id @default(cuid())
  campaignId        String
  powerId           String
  isEnabled         Boolean @default(true)
  customPowerPoints Int? // Optional override per campaign
  notes             String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([campaignId, powerId])
  @@index([campaignId])
}

model CampaignSkill {
  id         String  @id @default(cuid())
  campaignId String
  skillId    String
  isEnabled  Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([campaignId, skillId])
  @@index([campaignId])
}

model CampaignHindrance {
  id          String  @id @default(cuid())
  campaignId  String
  hindranceId String
  isEnabled   Boolean @default(true)

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([campaignId, hindranceId])
  @@index([campaignId])
}

model CampaignSource {
  id         String @id @default(cuid())
  campaignId String
  sourceName String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  source   Source   @relation(fields: [sourceName], references: [name])

  @@unique([campaignId, sourceName])
  @@index([campaignId])
}

model CampaignItem {
  id         String  @id @default(cuid())
  campaignId String
  itemId     String
  dieType    DieType @default(D4)
  modifier   Int     @default(0)
  notes      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([campaignId, itemId]) // Prevent duplicates
  @@index([campaignId])
}

