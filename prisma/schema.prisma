//////////////////////////////////////
//      CAMPAIGN JOIN TABLES       //
////////////////////////////////////

model CampaignPlayerCharacter {
  id          String  @id @default(cuid())
  campaignId  String
  characterId String
  nickname    String?
  notes       String?

  campaign Campaign        @relation(fields: [campaignId], references: [id])
  creature PlayerCharacter @relation(fields: [characterId], references: [id])

  @@unique([campaignId, characterId])
}

model CampaignWildCard {
  id         String  @id @default(cuid())
  campaignId String
  wildCardId String
  nickname   String?
  notes      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  creature WildCard @relation(fields: [wildCardId], references: [id])

  @@unique([campaignId, wildCardId])
}

model CampaignCreature {
  id         String  @id @default(cuid())
  campaignId String
  creatureId String
  nickname   String?
  notes      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  creature Creature @relation(fields: [creatureId], references: [id])

  @@unique([campaignId, creatureId])
}

model CampaignEdge {
  id         String  @id @default(cuid())
  campaignId String
  edgeId     String
  isEnabled  Boolean @default(true)

  campaign            Campaign           @relation(fields: [campaignId], references: [id])
  edge                Edge               @relation(fields: [edgeId], references: [id])
  CharacterTemplate   CharacterTemplate? @relation(fields: [characterTemplateId], references: [id])
  characterTemplateId String?

  @@unique([campaignId, edgeId])
}

model CampaignPower {
  id         String  @id @default(cuid())
  campaignId String
  powerId    String
  isEnabled  Boolean @default(true)
  notes      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([campaignId, powerId])
}

model CampaignSkill {
  id         String  @id @default(cuid())
  campaignId String
  skillId    String
  isEnabled  Boolean @default(true)

  campaign            Campaign           @relation(fields: [campaignId], references: [id])
  skill               Skill              @relation(fields: [skillId], references: [id])
  CharacterTemplate   CharacterTemplate? @relation(fields: [characterTemplateId], references: [id])
  characterTemplateId String?

  @@unique([campaignId, skillId])
}

model CampaignHindrance {
  id          String @id @default(cuid())
  campaignId  String
  hindranceId String

  campaign            Campaign           @relation(fields: [campaignId], references: [id])
  hindrance           Hindrance          @relation(fields: [hindranceId], references: [id])
  CharacterTemplate   CharacterTemplate? @relation(fields: [characterTemplateId], references: [id])
  characterTemplateId String?

  @@unique([campaignId, hindranceId])
}

model CampaignSource {
  id         String @id @default(cuid())
  campaignId String
  sourceId   String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  source   Source   @relation(fields: [sourceId], references: [id])

  @@unique([campaignId, sourceId])
}

model CampaignItem {
  id         String  @id @default(cuid())
  campaignId String
  itemId     String
  dieType    DieType @default(d4)
  modifier   Int     @default(0)
  notes      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([campaignId, itemId]) // Prevent duplicates
}

///////////////////////////////////////
//      CHARACTER JOIN TABLES       //
/////////////////////////////////////

model PlayerCharacterEdge {
  id                String  @id @default(cuid())
  playerCharacterId String
  edgeId            String
  notes             String?
  isEnabled         Boolean @default(true)

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  edge      Edge            @relation(fields: [edgeId], references: [id])

  @@unique([playerCharacterId, edgeId])
}

model PlayerCharacterPower {
  id                String  @id @default(cuid())
  playerCharacterId String
  powerId           String
  customName        String? // e.g., "Frozen Blast" instead of "Blast"
  notes             String?
  trapping          String?
  isEnabled         Boolean @default(true)

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  power     Power           @relation(fields: [powerId], references: [id])

  @@unique([playerCharacterId, powerId])
}

model PlayerCharacterSkill {
  id                String  @id @default(cuid())
  playerCharacterId String
  skillId           String
  dieType           DieType @default(d4)
  modifier          Int     @default(0)
  notes             String?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  skill     Skill           @relation(fields: [skillId], references: [id])

  @@unique([playerCharacterId, skillId]) // Prevent duplicates
}

model PlayerCharacterItem {
  id                String  @id @default(cuid())
  playerCharacterId String
  itemId            String
  quantity          Int     @default(1)
  dieType           DieType @default(d4)
  modifier          Int     @default(0)
  notes             String?

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  item      Item            @relation(fields: [itemId], references: [id])

  @@unique([playerCharacterId, itemId]) // Prevent duplicates
}

model PlayerCharacterHindrance {
  id                String @id @default(cuid())
  playerCharacterId String
  hindranceId       String

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  hindrance Hindrance       @relation(fields: [hindranceId], references: [id])

  @@unique([playerCharacterId, hindranceId])
}

////////////////////////////////////////////////
//      WILDCARD CHARACTER JOIN TABLES       //
//////////////////////////////////////////////

model WildCardEdge {
  id         String  @id @default(cuid())
  wildCardId String
  edgeId     String
  notes      String?
  isEnabled  Boolean @default(true)

  wildCard WildCard @relation(fields: [wildCardId], references: [id])
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([wildCardId, edgeId])
}

model WildCardPower {
  id         String  @id @default(cuid())
  wildCardId String
  powerId    String
  customName String? // e.g., "Frozen Blast" instead of "Blast"
  notes      String?
  trapping   String?
  isEnabled  Boolean @default(true)

  wildCard WildCard @relation(fields: [wildCardId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([wildCardId, powerId])
}

model WildCardSkill {
  id         String  @id @default(cuid())
  wildCardId String
  skillId    String
  dieType    DieType @default(d4)
  modifier   Int     @default(0)
  notes      String?

  charawildCardcter WildCard @relation(fields: [wildCardId], references: [id])
  skill             Skill    @relation(fields: [skillId], references: [id])

  @@unique([wildCardId, skillId]) // Prevent duplicates
}

model WildCardItem {
  id         String  @id @default(cuid())
  wildCardId String
  itemId     String
  dieType    DieType @default(d4)
  modifier   Int     @default(0)
  notes      String?

  wildCard WildCard @relation(fields: [wildCardId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([wildCardId, itemId]) // Prevent duplicates
}

model WildCardHindrance {
  id          String @id @default(cuid())
  wildCardId  String
  hindranceId String

  wildCard  WildCard  @relation(fields: [wildCardId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([wildCardId, hindranceId])
}

//////////////////////////////////////
//      CREATURE JOIN TABLES       //
////////////////////////////////////

model RaceEdge {
  id     String @id @default(cuid())
  raceId String
  edgeId String

  race Race @relation(fields: [raceId], references: [id])
  edge Edge @relation(fields: [edgeId], references: [id])

  @@unique([raceId, edgeId])
}

model RacePower {
  id      String @id @default(cuid())
  raceId  String
  powerId String

  race  Race  @relation(fields: [raceId], references: [id])
  power Power @relation(fields: [powerId], references: [id])

  @@unique([raceId, powerId])
}

model RaceSkill {
  id      String @id @default(cuid())
  raceId  String
  skillId String

  race  Race  @relation(fields: [raceId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([raceId, skillId])
}

model RaceSpecialAbility {
  id               String @id @default(cuid())
  raceId           String
  specialAbilityId String

  race           Race           @relation(fields: [raceId], references: [id])
  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])

  @@unique([raceId, specialAbilityId])
}

model RaceHindrance {
  id          String @id @default(cuid())
  raceId      String
  hindranceId String

