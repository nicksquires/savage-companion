generator client {
  provider = "prisma-client-js"
  //output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  //shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

///////////////////////
//      ENUMS       //
/////////////////////

enum Role {
  FREE
  BASIC
  PREMIUM
  ADMIN
}

enum Rank {
  NOVICE
  SEASONED
  VETERAN
  HEROIC
  LEGENDARY
}

enum Attribute {
  AGILITY
  SMARTS
  SPIRIT
  STRENGTH
  VIGOR
}

enum RequirementType {
  ATTRIBUTE
  SKILL
  EDGE
}

enum SourceType {
  CORE
  COMPANION
  HOMEBREW
  THIRD_PARTY
}

enum DieType {
  D4
  D6
  D8
  D10
  D12
  D20
  D30
  D50
  D100
}

enum HindranceType {
  MINOR
  MAJOR
}

enum EventType {
  NARRATIVE
  COMBAT
  EXPLORATION
  PUZZLE
  SOCIAL
  TRAVEL
}

enum ItemType {
  WEAPON // Swords, guns, bows, claws
  ARMOR // Armor, shields, protective gear
  CONSUMABLE // Potions, ammo, food, drugs, scrolls
  TOOL // Utility items: rope, lockpicks, lanterns, crafting kits
  ARTIFACT // Unique magical/technological devices (magic device, relics, advanced tech)
  KEY_ITEM // Campaign-specific items: plot keys, quest tokens, one-off puzzle items
  COMPONENT // Mods/upgrades/crafting components to a void TOOL bloat
  MATERIAL // Crafting/building materials (may use COMPONENT instead)
  MISC // Truly trivial/flavor items with no structured mechanics
}

// enum ArmorLayer {
//   NATURAL
//   LESSER
//   WORN
// }

enum SessionStatus {
  PLANNED
  ACTIVE
  PAUSED
  ENDED
}

enum EntityType {
  PC
  CREATURE
}

enum ConditionType {
  // --- Core Savage Worlds Conditions ---
  // May be isolated to game logic, but enum exists for
  // potential state management on game session save/load
  SHAKEN
  DISTRACTED
  VULNERABLE
  ENTANGLED
  BOUND
  PRONE
  STUNNED
  FATIGUED
  EXHAUSTED
  INCAPACITATED

  // --- Environmental & Physical Conditions ---
  POISONED
  DRENCHED
  FROZEN
  BURNING
  HOT
  BLEEDING
  BLINDED
  DEAFENED
  SICKENED
  SUFFOCATING

  // --- Mental & Social Conditions ---
  FRIGHTENED
  ENRAGED
  CONFUSED
  CHARMED
  DOMINATED
  HOPELESS
  SHAMED

  // --- Supernatural & Arcane Conditions ---
  CURSED
  PETRIFIED
  WEAKENED
  HAUNTED
  ETHEREAL

  // --- Sci-Fi & Technological Conditions ---
  IRRADIATED
  HACKED
  MAGNETIZED
  SYSTEM_SHOCK
  JAMMED

  // --- Special / Custom ---
  CUSTOM // For homebrew conditions
}

enum WeaponCategory {
  MELEE
  RANGED
  THROWN
  IMPROVISED

  FIREARM
  BLACK_POWDER
  ENERGY
  BOW
  CROSSBOW
  MAGIC
  PSIONIC

  HEAVY
  LIGHT
  TWO_HANDED
  ONE_HANDED
  REACH
  CONCEALED
  AREA
  SUPPRESSIVE

  PISTOL
  RIFLE
  SHOTGUN
  SMG
  CARBINE
  LAUNCHER
  MELEE_BLADE
  MELEE_BLUNT
  MELEE_PIERCE
  POLEARM
}

enum DamageType {
  NORMAL
  PIERCING
}

enum TargetType {
  SELF // Applies to the user/wielder
  ALLY // Applies to friendly targets
  ENEMY // Applies to hostile targets
  MULTI // Applies to multiple (e.g., allies or enemies in range)
  AREA // Applies to an area template (e.g., Small Burst)
  OBJECT // Applies to items/objects (rare, e.g., repair effects)
}

// enum EffectTrigger {
//   ON_ATTACK
//   ON_HIT
//   ON_RAISE
//   ON_MISS
//   ON_DAMAGE
//   ON_BEING_HIT
//   ON_ITEM_HIT
//   ON_EQUIP
//   ON_UNEQUIP
//   ON_USE
//   PASSIVE
// }

// “some effects activate only when the wielder is struck”
// “some effects activate if the item is struck”
enum EffectContext {
  WIELDER // Character holding the item
  TARGET // Who is affected
  ITEM // The item itself (weapon, armor)
  SOURCE // Origin of the effect (spell, artifact)
  AREA
}

// May be replaced by EffectType
enum SpecialAbilityCategory {
  MOVEMENT
  OFFENSE
  DEFENSE
  IMMUNITIES
  RESISTANCE
  WEAKNESS
  SENSES
  TRAITS
  RECOVERY
  STATUSEFFECT
  COMBAT
  DURABILITY
  HAZARD
}

enum FirearmMountType {
  NONE
  BIPOD
  TRIPOD
  VEHICLE
}

enum SettingType {
  MEDIEVAL
  MODERN
  WESTERN
  KIDS_ON_BIKES
  SLASHER
  HORROR
  FUTURISTIC
  ANCIENT_TIMES
  OTHERWORLD
}

enum ModifierEntityType {
  PLAYER
  CREATURE
  ITEM
  ENTITY
}

enum ModifierSourceType {
  POWER
  ITEM
  EDGE
  ABILITY
  NARRATIVE
  SYSTEM
}

enum DurationType {
  ROUNDS
  MINUTES
  HOURS
  ENCOUNTER // ends when combat ends
  PERMANENT // Items, edges, racial abilities
}

// The Account model in your schema is intended to support multiple 
// login providers per user. This doesn’t mean a user can log in as 
// multiple users, but rather that a single user can link multiple 
// authentication methods to their one account.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String                     @id @default(cuid())
  name             String?
  email            String                     @unique
  emailVerified    DateTime?                  @map("email_verified")
  hashedPassword   String?
  image            String?
  role             Role                       @default(FREE)
  accounts         Account[]
  sessions         Session[]
  registeredAt     DateTime                   @default(now())
  campaigns        Campaign[]
  campaignTemplate CampaignStartingTemplate[]
  campaignGMs      CampaignGM[] // Campaigns where user is GM (promoted) 
  PlayerCharacters PlayerCharacter[]

  registeredSources Source[]
  subscriptions     Subscription[] // Link to subscriptions 

  // Homebrew Content
  customEdges             Edge[]
  customPowers            Power[]
  customCreatures         Creature[]
  customSpecialAbilities  SpecialAbility[]
  customItems             Item[]
  customSkills            Skill[]
  customHindrances        Hindrance[]
  customRaces             Race[]
  customArcaneBackgrounds ArcaneBackground[]

  // Journals/Sessions 
  gmJournalEntries     GMJournalEntry[]
  playerJournalEntries PlayerJournalEntry[]
  campaignSession      CampaignSession[]

  @@index([email, role])
  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  tier      Role // BASIC, PREMIUM (sync with User.role) 
  startDate DateTime  @default(now())
  endDate   DateTime? // Null for lifetime or active 
  status    String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED 
  paymentId String? // Stripe ID or similar 

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

///////////////////////////////////////
//      GAME MECHANICS MODELS       //
/////////////////////////////////////

model Campaign {
  id                 String  @id @default(cuid())
  name               String
  description        String? @db.Text // Short description or blurb
  setting            String? // E.g., "Fantasy", "Sci-Fi"
  isActive           Boolean @default(true)
  startingTemplateId String?
  ownerId            String // Primary GM/creator 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner   User             @relation(fields: [ownerId], references: [id])
  gms     CampaignGM[] // Multiple GMs 
  sources CampaignSource[] // Join model

  sessions           CampaignSession[] // NEW: linked play sessions
  edges              CampaignEdge[] // campaign-specific edge selection
  powers             CampaignPower[]
  hindrances         CampaignHindrance[]
  skills             CampaignSkill[]
  startingTemplate   CampaignStartingTemplate? @relation(fields: [startingTemplateId], references: [id])
  assets             CampaignAsset[] // Arbitrary images 
  campaignNote       CampaignNote[]
  playerCharacters   PlayerCharacter[]
  characterInstances CharacterInstance[]
  creatureInstances  CreatureInstance[]

  @@index([name, ownerId])
}

model CampaignGM {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  promotedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
}

model CampaignStartingTemplate {
  id          String  @id @default(cuid())
  name        String // e.g., "Psionics Heavy | The Last Parsec"
  description String?
  bonuses     Json? // Flexible: { "extraSkillPoints": 3, "autoSkills": [{ "skillId": "psionics-id", "dieType": "D4", "modifier": 0 }], "extraAttributePoints": 1, "autoEdges": ["arcane-resistance-id"], "extraWealth": 500 }

  isHomebrew Boolean  @default(false)
  ownerId    String? // GM who created it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  owner     User?      @relation(fields: [ownerId], references: [id])
  campaigns Campaign[] // Back-relation: templates can be reused

  @@index([name, ownerId])
}

model CampaignSession {
  id         String        @id @default(cuid())
  title      String
  summary    String? // Quick recap of the session
  date       DateTime      @default(now())
  duration   Int? // In minutes, optional, or format later to (days,hours,minutes)
  status     SessionStatus @default(PLANNED) // PLANNED, ACTIVE, ENDED 
  gmId       String? // GM for the session
  campaignId String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  gm       User?    @relation(fields: [gmId], references: [id])

  highlights      SessionEvent[] // Optional: individual events or milestones
  playerJournals  PlayerJournalEntry[]
  gmJournals      GMJournalEntry[]
  characterStates SessionCharacterState[] // New relation for state snapshots

  @@index([campaignId, date])
}

model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  timestamp   DateTime  @default(now())
  description String    @db.Text
  type        EventType @default(NARRATIVE) // e.g., Combat, RP, Travel

  session CampaignSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model SessionCharacterState {
  id         String     @id @default(cuid())
  sessionId  String
  entityId   String // References either CampaignPlayerCharacter.id or CampaignCreature.id
  entityType EntityType // PC or CREATURE
  bennies    Int        @default(3) // Wild Cards only; Extras typically 0
  fatigue    Int        @default(0)
  wounds     Int        @default(0) // Max 3 for Wild Cards
  conditions Json?
  notes      String?    @db.Text // Additional GM notes
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])

  playerCharacter    PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id])
  playerCharacterId  String?
  creatureInstance   CreatureInstance? @relation(fields: [creatureInstanceId], references: [id])
  creatureInstanceId String?

  @@unique([sessionId, entityId, entityType])
  @@index([sessionId, entityId, entityType])
}

model PlayerJournalEntry {
  id          String  @id @default(cuid())
  sessionId   String
  userId      String
  characterId String? // Added for per-character journals 
  title       String
  body        String

  isPrivate Boolean  @default(true) // Players may choose to share or keep it private
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   CampaignSession  @relation(fields: [sessionId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  character PlayerCharacter? @relation(fields: [characterId], references: [id]) // Optional link 

  @@unique([sessionId, userId, characterId]) // Allow per-character/session uniqueness 
  @@index([userId, characterId])
}

model GMJournalEntry {
  id        String   @id @default(cuid())
  sessionId String
  gmId      String
  title     String
  body      String
  isPublic  Boolean  @default(false) // Added for public/private 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CampaignSession @relation(fields: [sessionId], references: [id])
  gm      User            @relation(fields: [gmId], references: [id])

  @@index([sessionId, gmId])
}

model PlayerCharacter {
  id         String  @id @default(cuid())
  name       String
  concept    String? // Optional character concept or tagline
  userId     String // Owner of the character (user)
  raceId     String
  isActive   Boolean @default(true)
  imageUrl   String? // Added for optional images 
  campaignId String?

  // Advancement
  rank            Rank @default(NOVICE) // e.g., "NOVICE", "Seasoned"
  advancesSpent   Int  @default(0) // Taken/applied
  advancesUnspent Int  @default(0)
  experience      Int? @default(0) // Optional progress tracking between advances

  // Attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived/Combat Stats
  pace      Int @default(6)
  parry     Int @default(0)
  toughness Int
  armor     Int @default(0)

  // Transient stats
  startingBennies Int @default(3)
  bennies         Int @default(3)
  wounds          Int @default(0)
  fatigue         Int @default(0)
  wealth          Int @default(500)

  description String? // Background, personality, etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  user              User                              @relation(fields: [userId], references: [id])
  race              Race                              @relation(fields: [raceId], references: [id])
  campaign          Campaign?                         @relation(fields: [campaignId], references: [id])
  edges             PlayerCharacterEdge[]
  powers            PlayerCharacterPower[]
  skills            PlayerCharacterSkill[]
  hindrances        PlayerCharacterHindrance[]
  arcaneBackgrounds PlayerCharacterArcaneBackground[]

  inventory ItemInstance[]
  journals  PlayerJournalEntry[] // Back-relation for per-character notes 
  // campaigns         CampaignPlayerCharacter[]

  advancementLogs       AdvancementLog[] // Tracks advances
  SessionCharacterState SessionCharacterState[]
  characterInstance     CharacterInstance?

  @@index([userId, name, raceId])
}

model CharacterInstance {
  id          String @id @default(cuid())
  characterId String @unique
  campaignId  String

  wounds  Int @default(0)
  fatigue Int @default(0)
  bennies Int @default(0)

  powerPoints Int?
  shaken      Boolean @default(false)

  inventory ItemInstance[]

  character PlayerCharacter @relation(fields: [characterId], references: [id])
  campaign  Campaign        @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

// NEW: Optional log for auditability
model AdvancementLog {
  id                String          @id @default(cuid())
  playerCharacterId String
  spentAt           DateTime        @default(now())
  description       String // e.g., "Edge: Quick" or "Attribute: Agility d6"
  playerCharacter   PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
}

// All creatures populate campaigns via their 'source'
model Creature {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  raceId      String? // If creature has race
  imageUrl    String? // Added for images 
  notes       String?

  // Base attributes
  agility  DieType @default(D4)
  smarts   DieType @default(D4)
  spirit   DieType @default(D4)
  strength DieType @default(D4)
  vigor    DieType @default(D4)

  // Derived Stats
  basePace      Int @default(6)
  baseParry     Int @default(0)
  baseToughness Int
  baseArmor     Int @default(0)

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?   @relation(fields: [ownerId], references: [id])
  source Source? @relation(fields: [sourceName], references: [name])
  race   Race?   @relation(fields: [raceId], references: [id])

  abilities         CreatureAbility[]
  edges             CreatureEdge[]
  powers            CreaturePower[] // New, if creatures can have powers (merged from WildCardPower) 
  skills            CreatureSkill[]
  tags              CreatureTag[]
  creatureHindrance CreatureHindrance[]
  creatureCategory  CreatureCategory[]
  creatureInstances CreatureInstance[]
  inventory         ItemInstance[]

  @@index([name, ownerId, sourceName])
}

model CreatureInstance {
  id String @id @default(cuid())

  creatureId String
  campaignId String

  nickname String?
  notes    String?

  // Campaign / runtime flags
  isWildCard Boolean @default(false)
  isNpc      Boolean @default(false)

  // Runtime state
  bennies Int @default(3)
  wounds  Int @default(0)
  fatigue Int @default(0)

  // Optional overrides (buffs, debuffs, damage)
  paceOverride      Int?
  parryOverride     Int?
  toughnessOverride Int?
  armorOverride     Int?

  creature Creature @relation(fields: [creatureId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  // Active play state
  items ItemInstance[]

  // Session tracking (optional)
  sessionStates     SessionCharacterState[]
  creatureModifiers EntityModifier[]

  @@unique([campaignId, creatureId])
  @@index([campaignId])
}

// Core savage worlds mutation model
// For 'CREATURE' types modifiers: Look at promotion later, 
// "Save as New Creature" and flatten base+modifiers of 
// creature instance
model EntityModifier {
  id          String  @id @default(cuid())
  name        String
  description String?

  entityType ModifierEntityType
  entityId   String

  sourceType ModifierSourceType
  sourceId   String?

  durationType      DurationType
  durationRemaining Int?

  data      Json // validated by Zod (see below)
  condition Json? // complex "if" rules
  priority  Int   @default(0) // application order

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatureInstance   CreatureInstance? @relation(fields: [creatureInstanceid], references: [id])
  creatureInstanceid String?
}

model Race {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  ancestry    String? // Optional field for grouping (e.g., Elf, Human, etc.)
  imageUrl    String? // Added for images 

  sourceName String? // Reference to source book
  ownerId    String? // For homebrew authorship
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?           @relation(fields: [sourceName], references: [name])
  owner           User?             @relation(fields: [ownerId], references: [id])
  characters      PlayerCharacter[]
  creatures       Creature[] // For wildcard races
  racialAbilities RacialAbility[]

  @@index([name, sourceName, ownerId])
}

model RacialAbility {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String // e.g., "Low Light Vision", "Aquatic"
  description String? @db.Text
  value       Int // Point cost: +2, -1, etc.

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  // Relations
  races            Race[]
  source           Source?         @relation(fields: [sourceName], references: [name])
  skill            Skill?          @relation(fields: [skillId], references: [id])
  skillId          String?
  edge             Edge?           @relation(fields: [edgeId], references: [id])
  edgeId           String?
  power            Power?          @relation(fields: [powerId], references: [id])
  powerId          String?
  specialAbility   SpecialAbility? @relation(fields: [specialAbilityId], references: [id])
  specialAbilityId String?
  hindrance        Hindrance?      @relation(fields: [hindranceId], references: [id])
  hindranceId      String?
}

model Skill {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  linkedAttribute Attribute // "AGILITY", "SMARTS", etc.
  description     String?   @db.Text

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String? // Reference to owner if homebrew
  sourceName String? // Reference to source book

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User?                  @relation(fields: [ownerId], references: [id])
  source           Source?                @relation(fields: [sourceName], references: [name])
  characterSkills  PlayerCharacterSkill[]
  creatureSkills   CreatureSkill[]
  campaignSkills   CampaignSkill[]
  tags             SkillTag[]
  racialSkill      RacialAbility[]
  arcaneBackground ArcaneBackground[]

  @@index([name, sourceName, ownerId])
}

model Edge {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  sourceName String
  rank       Rank    @default(NOVICE)
  category   String? // e.g., Background, Combat, Social

  /// Canonical rules text (for UI / reference only)
  description String? @db.Text
  summary     String? @db.Text

  /// Structured prerequisites (attributes, skills, other edges, etc.)
  requirements Json?

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  // Metadata
  isHomebrew Boolean  @default(false)
  isPublic   Boolean  @default(true)
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // RELATIONS
  owner          User?                 @relation(fields: [ownerId], references: [id])
  source         Source                @relation(fields: [sourceName], references: [name])
  campaignEdges  CampaignEdge[]
  characterEdges PlayerCharacterEdge[]
  creatureEdges  CreatureEdge[]
  tags           EdgeTag[]
  racialEdge     RacialAbility[]

  @@index([name, rank, category, sourceName])
}

model ArcaneBackground {
  id             String  @id @default(cuid()) // Changed for consistency
  name           String  @unique // Ensure unique names for easy lookup
  arcaneSkillId  String
  startingPowers Int
  powerPoints    Int
  description    String  @db.Text
  summary        String? @db.Text

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true) // Default true for core visibility
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now()) // Added for consistency
  updatedAt DateTime @updatedAt // Added for consistency

  // Relations
  arcaneSkill Skill   @relation(fields: [arcaneSkillId], references: [id])
  source      Source? @relation(fields: [sourceName], references: [name])
  owner       User?   @relation(fields: [ownerId], references: [id])

  playerCharacters PlayerCharacterArcaneBackground[] // Back-relation for many-to-many

  @@index([name, sourceName])
}

model Power {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  rank        Rank    @default(NOVICE) // enum: NOVICE, Seasoned, etc.
  powerPoints Int // Power cost
  // range       Int? // Usually derived from SMARTS
  duration    String?
  trappings   String? // Suggested trappings
  description String  @db.Text
  summary     String? @db.Text
  // powerModifiers   String? // Possible modifiers (i.e., DAMAGE(+1) or SIZE (+1))

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source          Source?                @relation(fields: [sourceName], references: [name])
  owner           User?                  @relation(fields: [ownerId], references: [id])
  campaignPowers  CampaignPower[]
  characterPowers PlayerCharacterPower[]
  creaturePowers  CreaturePower[]
  racialPower     RacialAbility[]
  tags            PowerTag[]

  @@index([name, rank, sourceName])
}

model SpecialAbility {
  id          String  @id @default(cuid())
  name        String  @unique
  description String  @db.Text
  summary     String? @db.Text
  category    String // e.g., Movement, Defense, Offense, etc.
  parameters  Json? // e.g., { pace: "6", breathTemplate: "Cone", etc. }
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Homebrew / Visibility
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(false)
  ownerId    String?
  sourceName String?

  // RELATIONS
  source            Source?             @relation(fields: [sourceName], references: [name])
  owner             User?               @relation(fields: [ownerId], references: [id])
  creatureAbilities CreatureAbility[]
  racialAbilities   RacialAbility[]
  tags              SpecialAbilityTag[]
}

model Hindrance {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String        @db.Text
  severity    HindranceType // Enum: MAJOR | MINOR
  summary     String?       @db.Text
  notes       String?       @db.Text

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  // Metadata
  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  source Source? @relation(fields: [sourceName], references: [name])
  owner  User?   @relation(fields: [ownerId], references: [id])

  characterHindrances PlayerCharacterHindrance[]
  creatureHindrances  CreatureHindrance[]
  campaignHindrances  CampaignHindrance[]
  racialHindrance     RacialAbility[]

  @@index([name, severity, sourceName])
}

model Item {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  type        ItemType // e.g., weapon, armor, tool
  cost        Int?
  weight      Float? // e.g., '15', '(1/20)'
  imageUrl    String?

  isHomebrew Boolean @default(false)
  isPublic   Boolean @default(true)
  ownerId    String?
  sourceName String?

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  source Source? @relation(fields: [sourceName], references: [name])
  owner  User?   @relation(fields: [ownerId], references: [id])

  // Relations to specialized models (1-to-1 optional)
  weapon     Weapon?
  armor      Armor?
  consumable Consumable?
  tool       Tool?
  artifact   Artifact?
  // magicDevice MagicDevice?

  // Relations to game entities
  tags          ItemTag[]
  itemInstances ItemInstance[]
  ammunitions   Ammunition[]

  @@index([name, type, sourceName])
}

model ItemInstance {
  id     String @id @default(cuid())
  itemId String

  // Ownership (exactly one should be set, enforced in app logic)
  characterId String?
  creatureId  String?
  containerId String?

  quantity   Int     @default(1)
  notes      String?
  isEquipped Boolean @default(false)

  // THE STATE FIELD
  // Stores dynamic data: { ammo: 6, isJammed: true, charges: 3, etc. }
  state Json @default("{}")

  // Definition
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  characterInstance   CharacterInstance? @relation(fields: [characterInstanceId], references: [id])
  characterInstanceId String?
  creatureInstance    CreatureInstance?  @relation(fields: [creatureInstanceId], references: [id])
  creatureInstanceId  String?

  // Back-relations to the owners (Ensure these match the @relation in the other files)
  // container Container?      @relation(fields: [containerId], references: [id]) // i.e: chests, lootable objects
  character PlayerCharacter? @relation(fields: [characterId], references: [id])
  creature  Creature?        @relation(fields: [creatureId], references: [id])

  //@@index([containerId])
  @@index([characterId])
  @@index([creatureId])
}

model WeaponCategoryAssignment {
  weaponId String
  category WeaponCategory

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@id([weaponId, category])
}

model Weapon {
  id         String                     @id @default(cuid())
  itemId     String                     @unique
  categories WeaponCategoryAssignment[] // e.g., "MELEE", "RANGED"
  setting    SettingType? // e.g., MODERN, FUTURISTIC

  damage      String? // e.g., "Str+d6" or "2d8"
  range       String? // e.g., "3/6/12" or "Melee"
  rof         Int? // Rate of Fire
  ap          Int? // Armor Piercing
  caliber     Float? // e.g., ".30" or "5.7"
  minStrength String? // e.g., "d6"

  firearm Firearm?
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Firearm {
  id       String @id @default(cuid())
  weaponId String @unique

  // firearmType   FirearmType? // e.g., SHOTGUN, LASER, SMG, BLACK POWDER
  ammoCapacity  Int? // e.g., 6 for revolver, 50 for machine gun belt
  reloadActions Int? // Number of actions to reload (e.g., 2 for Reload 2)

  mountType     FirearmMountType? // Affects Recoil, Strength requirements
  blastTemplate String? // e.g., "Small Burst" for HE rounds
  overchargeDie String? // e.g., "d6" for laser overcharge damage
  specialAmmo   String?           @db.Text // JSON or text for slugs, tracers, etc.

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@index([mountType])
}

model Ammunition {
  id           String  @id @default(cuid())
  itemId       String  @unique
  caliber      Int?
  ap           Int?
  damageMod    String?
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  item Item @relation(fields: [itemId], references: [id])
}

model Armor {
  id     String @id @default(cuid())
  itemId String @unique

  armorBonus   Int
  covers       String?
  minStrength  String?
  parryPenalty Int?

  // THE BLUEPRINT: This holds an array of modifier objects based on schema enums
  modifierData Json? // e.g., [{ target: "DERIVED_STAT", key: "Pace", operation: "SUBTRACT", value: 1 }]

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "UNHOLY", "SUPERNATURAL"
  slug        String  @unique
  description String? @db.Text

  // Many-to-many with Creature (creatures belonging to categories)
  creatures CreatureCategory[]
}

model CreatureCategory {
  creatureId String
  categoryId String

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatureId, categoryId])
}

model Consumable {
  id          String  @id @default(cuid())
  itemId      String  @unique
  description String  @db.Text // Healing, buff, etc.
  maxUses     Int? // e.g., 3 charges
  isStackable Boolean @default(true)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tool {
  id     String @id @default(cuid())
  itemId String @unique

  // What kind of bonus this tool provides
  skill      String? // e.g. "THIEVERY", "REPAIR"
  skillBonus Int? // e.g. +2

  // Maximums / defaults
  maxUses       Int? // e.g. lockpicks
  maxDurability Int? // e.g. fragile tools

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Artifact {
  id     String @id @default(cuid())
  itemId String @unique

  rarity String? // Common, Rare, Legendary

  // What it does mechanically
  description String @db.Text

  maxCharges Int?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Join Tables
  edgeTags           EdgeTag[]
  powerTags          PowerTag[]
  creatureTags       CreatureTag[]
  specialAbilityTags SpecialAbilityTag[]
  skillTags          SkillTag[]
  itemTags           ItemTag[]

  @@index([name])
}

model CampaignNote {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model Source {
  id           String     @id @default(cuid())
  name         String     @unique // e.g., "Core Rules", "Fantasy Companion"
  type         SourceType @default(CORE) // Enum to distinguish source type
  abbreviation String? // e.g., "SWADE", "FC"
  description  String?    @db.Text
  publisher    String? // e.g., "Pinnacle Entertainment Group"
  url          String? // Optional link to official site or PDF
  isHomebrew   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  // RELATIONS

  abilities         SpecialAbility[]
  edges             Edge[]
  arcaneBackgrounds ArcaneBackground[]
  skills            Skill[]
  powers            Power[]
  creatures         Creature[]
  items             Item[]
  hindrances        Hindrance[]
  races             Race[]
  racialAbilities   RacialAbility[]
  campaigns         CampaignSource[]

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([name, type])
}

model CampaignAsset {
  id         String  @id @default(cuid())
  campaignId String
  name       String // e.g., "Town Map", "NPC Portrait" 
  imageUrl   String
  type       String? // e.g., "LOCATION", "NPC", "PROP" 
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, name])
}

//////////////////////////////////////
//      CAMPAIGN JOIN TABLES       //
////////////////////////////////////

model CampaignEdge {
  id         String  @id @default(cuid())
  campaignId String
  edgeId     String
  isEnabled  Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([campaignId, edgeId])
  @@index([campaignId])
}

model CampaignPower {
  id                String  @id @default(cuid())
  campaignId        String
  powerId           String
  isEnabled         Boolean @default(true)
  customPowerPoints Int? // Optional override per campaign
  notes             String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([campaignId, powerId])
  @@index([campaignId])
}

model CampaignSkill {
  id         String  @id @default(cuid())
  campaignId String
  skillId    String
  isEnabled  Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([campaignId, skillId])
  @@index([campaignId])
}

model CampaignHindrance {
  id          String  @id @default(cuid())
  campaignId  String
  hindranceId String
  isEnabled   Boolean @default(true)

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([campaignId, hindranceId])
  @@index([campaignId])
}

model CampaignSource {
  id         String @id @default(cuid())
  campaignId String
  sourceName String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  source   Source   @relation(fields: [sourceName], references: [name])

  @@unique([campaignId, sourceName])
  @@index([campaignId])
}

///////////////////////////////////////
//      CHARACTER JOIN TABLES       //
/////////////////////////////////////

model PlayerCharacterEdge {
  id                String  @id @default(cuid())
  playerCharacterId String
  edgeId            String
  notes             String?
  isEnabled         Boolean @default(true)

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  edge      Edge            @relation(fields: [edgeId], references: [id])

  @@unique([playerCharacterId, edgeId]) // Prevent duplicates
  @@index([playerCharacterId])
}

model PlayerCharacterArcaneBackground {
  id                 String  @id @default(cuid())
  playerCharacterId  String
  arcaneBackgroundId String
  notes              String? // Optional, for any per-assignment notes
  isEnabled          Boolean @default(true) // e.g., For toggling in campaigns

  character        PlayerCharacter  @relation(fields: [playerCharacterId], references: [id])
  arcaneBackground ArcaneBackground @relation(fields: [arcaneBackgroundId], references: [id])

  @@unique([playerCharacterId, arcaneBackgroundId]) // Prevent duplicates
  @@index([playerCharacterId])
}

model PlayerCharacterPower {
  id                String  @id @default(cuid())
  playerCharacterId String
  powerId           String
  customName        String? // e.g., "Frozen Blast" instead of "Blast"
  trapping          String?
  notes             String?
  isEnabled         Boolean @default(true) // For character-specific toggles, not availability

  createdAt DateTime @default(now()) // Added for consistency
  updatedAt DateTime @updatedAt // Added for consistency

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  power     Power           @relation(fields: [powerId], references: [id])

  @@unique([playerCharacterId, powerId]) // Prevent duplicates
  @@index([playerCharacterId]) // Optimize queries by character
}

model PlayerCharacterSkill {
  id                String  @id @default(cuid())
  playerCharacterId String
  skillId           String
  dieType           DieType @default(D4)

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  skill     Skill           @relation(fields: [skillId], references: [id])

  @@unique([playerCharacterId, skillId]) // Prevent duplicates
  @@index([playerCharacterId])
}

model PlayerCharacterHindrance {
  id                String @id @default(cuid())
  playerCharacterId String
  hindranceId       String

  character PlayerCharacter @relation(fields: [playerCharacterId], references: [id])
  hindrance Hindrance       @relation(fields: [hindranceId], references: [id])

  @@unique([playerCharacterId, hindranceId])
  @@index([playerCharacterId])
}

/////////////////////////////////
//      CREATURE JOIN TABLES      //
///////////////////////////////

model CreatureHindrance {
  id          String @id @default(cuid())
  creatureId  String
  hindranceId String

  creature  Creature  @relation(fields: [creatureId], references: [id])
  hindrance Hindrance @relation(fields: [hindranceId], references: [id])

  @@unique([creatureId, hindranceId])
  @@index([creatureId])
}

model CreatureAbility {
  id               String @id @default(cuid())
  creatureId       String
  specialAbilityId String

  creature       Creature       @relation(fields: [creatureId], references: [id])
  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])

  @@unique([creatureId, specialAbilityId])
  @@index([creatureId])
}

model CreatureEdge {
  id         String  @id @default(cuid())
  creatureId String
  edgeId     String
  notes      String?

  creature Creature @relation(fields: [creatureId], references: [id])
  edge     Edge     @relation(fields: [edgeId], references: [id])

  @@unique([creatureId, edgeId])
  @@index([creatureId])
}

model CreaturePower {
  id         String  @id @default(cuid())
  creatureId String
  powerId    String
  customName String?
  notes      String?
  trapping   String?
  isEnabled  Boolean @default(true)

  creature Creature @relation(fields: [creatureId], references: [id])
  power    Power    @relation(fields: [powerId], references: [id])

  @@unique([creatureId, powerId])
  @@index([creatureId])
}

model CreatureSkill {
  id         String  @id @default(cuid())
  creatureId String
  skillId    String
  dieType    DieType @default(D4)
  modifier   Int     @default(0)

  creature Creature @relation(fields: [creatureId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([creatureId, skillId])
  @@index([creatureId])
}

/////////////////////////////////
//      TAG JOIN TABLES       //
///////////////////////////////

model EdgeTag {
  id     String @id @default(cuid())
  edgeId String
  tagId  String

  edge Edge @relation(fields: [edgeId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@unique([edgeId, tagId])
  @@index([edgeId])
}

model PowerTag {
  id      String @id @default(cuid())
  powerId String
  tagId   String

  power Power @relation(fields: [powerId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@unique([powerId, tagId])
  @@index([powerId])
}

model CreatureTag {
  id         String @id @default(cuid())
  creatureId String
  tagId      String

  creature Creature @relation(fields: [creatureId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@unique([creatureId, tagId])
  @@index([creatureId])
}

model SpecialAbilityTag {
  id               String @id @default(cuid())
  specialAbilityId String
  tagId            String

  specialAbility SpecialAbility @relation(fields: [specialAbilityId], references: [id])
  tag            Tag            @relation(fields: [tagId], references: [id])

  @@unique([specialAbilityId, tagId])
  @@index([specialAbilityId])
}

model SkillTag {
  id      String @id @default(cuid())
  skillId String
  tagId   String

  skill Skill @relation(fields: [skillId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@unique([skillId, tagId])
  @@index([skillId])
}

model ItemTag {
  id     String @id @default(cuid())
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@unique([itemId, tagId])
  @@index([itemId])
}

